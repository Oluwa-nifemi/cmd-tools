#!/bin/sh
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
. "$SCRIPT_DIR/repl-lib.sh"

# --no-follow prints the last 80 log lines and exits. Plain watchrepl runs
# `tail -f`, which never exits and stalls any caller that waits for it (agents).
follow=true
if [ "${1:-}" = "--no-follow" ] || [ "${1:-}" = "-n" ]; then
    follow=false
    shift
fi

if [ "$#" -eq 1 ] && printf '%s\n' "$1" | grep -qE '^[0-9]+$'; then
    # Index from `repls` listing — resolve without needing to cd into the project
    root="$(resolve_worktree_by_index "$1")"
else
    root="$(require_project_root)"
fi
log_path="$(python3 - "$REPL_REGISTRY" "$root" <<'PY'
import json
import os
import sys

path, root = sys.argv[1:]
try:
    with open(path) as handle:
        entries = json.load(handle).get("worktrees", {})
except FileNotFoundError:
    entries = {}

entry = entries.get(root)
if entry:
    try:
        os.kill(int(entry["pid"]), 0)
        print(entry["log_path"])
    except (KeyError, OSError, TypeError, ValueError):
        pass
PY
)"

if [ -z "$log_path" ]; then
    echo "No live nREPL is registered for $root." >&2
    repls
    exit 1
fi

if [ "$follow" = false ]; then
    tail -n 80 "$log_path"
    exit 0
fi
echo "Tailing $log_path (Ctrl-C to stop)." >&2
tail -n 80 -f "$log_path"
