#!/bin/sh
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
. "$SCRIPT_DIR/repl-lib.sh"

usage() {
    echo "Usage: runrepl [--no-start] [--fresh] [--port-owner APP_PORT] CODE" >&2
    echo >&2
    echo "  --fresh            Kill existing REPL, start a fresh one, then evaluate." >&2
    echo "                     Use when stale state is unknown or widespread." >&2
    echo "  --port-owner APP_PORT  Target the worktree whose REPL holds APP_PORT" >&2
    echo "                         instead of the current project. Use this to stop" >&2
    echo "                         whichever worktree is running the app, e.g." >&2
    echo "                         runrepl --port-owner 3000 '(user/stop)'" >&2
}

no_start=false
fresh=false
port_owner=""
while true; do
    case "${1:-}" in
        --no-start)
            no_start=true
            shift
            ;;
        --fresh)
            fresh=true
            shift
            ;;
        --port-owner)
            if [ -z "${2:-}" ]; then
                usage
                exit 2
            fi
            port_owner="$2"
            shift 2
            ;;
        *)
            break
            ;;
    esac
done

if [ "$#" -ne 1 ]; then
    usage
    exit 2
fi

code="$1"

if [ -n "$port_owner" ]; then
    # Targeting by app port: never start a REPL, because the point is to reach
    # an app that is already running somewhere.
    root="$(registry_worktree_for_app_port "$port_owner")"
    if [ -z "$root" ]; then
        echo "No registered REPL is holding port $port_owner." >&2
        echo "Run 'repls' to see what is live." >&2
        exit 1
    fi
    port="$(registry_port "$root")"
    if [ -z "$port" ]; then
        echo "Found $root holding port $port_owner, but it has no registered nREPL port." >&2
        exit 1
    fi
    echo "Targeting $root (holds port $port_owner, nREPL on $port)." >&2
else
    root="$(require_project_root)"
    port="$(registry_port "$root")"
    if [ "$fresh" = true ] && [ -n "$port" ]; then
        # Kill the existing REPL before starting a clean one. This clears all
        # loaded state, including stale vars from renamed/deleted definitions.
        echo "Killing existing REPL for $(basename "$root") (--fresh)." >&2
        "$SCRIPT_DIR/killrepl" >/dev/null 2>&1 || true
        port=""
    fi
    if [ -z "$port" ]; then
        if [ "$no_start" = true ]; then
            echo "No live nREPL is registered for $root (--no-start)." >&2
            exit 1
        fi
        port="$(start_repl "$root")"
    fi
fi

# Evaluate and capture exit status. For test runs, clj-nrepl-eval may return 0
# even when clojure.test reports failures in the output. Parse the test summary
# to catch those and exit non-zero, so callers can trust the exit code.
eval_exit=0
output="$(clj-nrepl-eval -p "$port" "$code")" || eval_exit=$?
printf '%s\n' "$output"

if [ "$eval_exit" -eq 0 ]; then
    # Look for clojure.test summary: "N failures, N errors"
    if printf '%s\n' "$output" | grep -qE '^[0-9]+ failures, [0-9]+ errors'; then
        if ! printf '%s\n' "$output" | grep -qE '^0 failures, 0 errors'; then
            eval_exit=1
        fi
    fi
fi

touch_registry_entry "$root"
exit "$eval_exit"

