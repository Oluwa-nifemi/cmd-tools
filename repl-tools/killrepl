#!/bin/sh
# Kill a running REPL by index (from `repls`) or for the current project.
#
# Sends SIGTERM to the process group so the JVM and its children all go down,
# then removes the registry entry. Safe to run multiple times — a dead REPL
# just gets cleaned out of the registry.
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
. "$SCRIPT_DIR/repl-lib.sh"

usage() {
    echo "Usage: killrepl [--force] [INDEX]" >&2
    echo >&2
    echo "  INDEX  Kill the REPL at this index from 'repls'." >&2
    echo "         Without an index, kills the REPL for the current project." >&2
    echo "  --force  Also stop a live startup that holds the lock but has no" >&2
    echo "           registry entry yet." >&2
    exit 2
}

force=false
if [ "${1:-}" = --force ]; then
    force=true
    shift
fi

case "${1:-}" in
    -h|--help) usage ;;
esac

if [ "$#" -gt 1 ]; then
    usage
fi

if [ "$#" -eq 1 ] && printf '%s\n' "$1" | grep -qE '^[0-9]+$'; then
    # Index from `repls` listing — resolve without needing to cd into the project
    root="$(resolve_worktree_by_index "$1")"
elif [ "$#" -eq 0 ]; then
    # No argument: kill the REPL for the current project, like startrepl/watchrepl
    root="$(require_project_root)"
else
    usage
fi

# A startup that has not registered yet exists only as its lock directory.
# Without this, killrepl reported "no registry entry" and the next start
# waited on the same lock again. A dead owner's lock is always safe to clear.
# A live owner may be a valid startup in another terminal, so stopping it
# needs --force.
clear_startup_lock() {
    lock_path="$(lock_path_for "$root")"
    [ -d "$lock_path" ] || return 1
    name="$(basename "$root")"
    owner="$(cat "$lock_path/pid" 2>/dev/null || true)"
    child="$(cat "$lock_path/child_pid" 2>/dev/null || true)"
    if [ -n "$owner" ] && kill -0 "$owner" 2>/dev/null && [ "$force" = false ]; then
        age=$(( $(date +%s) - $(stat -f %m "$lock_path") ))
        command="$(ps -o command= -p "$owner" 2>/dev/null || true)"
        echo "killrepl: REPL startup for $name is in progress; lock=$lock_path owner-pid=$owner age=${age}s command=${command:-unknown}" >&2
        echo "Run 'killrepl --force' to stop it and clear the lock." >&2
        exit 1
    fi
    # The REPL runs in its own session, so its PID is also its process group.
    [ -n "$child" ] && kill -TERM "-$child" 2>/dev/null || true
    [ -n "$owner" ] && kill -TERM "$owner" 2>/dev/null || true
    remove_lock "$lock_path"
    echo "Cleared REPL startup lock for $name."
    return 0
}

if [ -z "$(registry_port "$root")" ] && clear_startup_lock; then
    exit 0
fi

# Kill the process group and remove the registry entry. Using killpg via
# Python because the REPL runs in its own session (setsid in start_repl),
# and we want the JVM and its children to all receive the signal.
python3 - "$REPL_REGISTRY" "$root" <<'PY'
import json
import os
import signal
import sys

path, root = sys.argv[1:]
try:
    with open(path) as handle:
        registry = json.load(handle)
except FileNotFoundError:
    print(f"killrepl: no registry file — nothing to kill.", file=sys.stderr)
    raise SystemExit(1)
except (OSError, json.JSONDecodeError) as error:
    print(f"killrepl: cannot read registry: {error}", file=sys.stderr)
    raise SystemExit(1)

entries = registry.get("worktrees", {})
entry = entries.get(root)
if not entry:
    name = root.rstrip("/").rsplit("/", 1)[-1]
    print(f"killrepl: no registry entry for {name}", file=sys.stderr)
    raise SystemExit(1)

pid = int(entry["pid"])
port = entry.get("port", "?")
name = root.rstrip("/").rsplit("/", 1)[-1]

try:
    os.killpg(os.getpgid(pid), signal.SIGTERM)
    print(f"Killed REPL for {name} (pid {pid}, port {port}).")
except ProcessLookupError:
    print(f"REPL for {name} (pid {pid}) was already dead — cleaning registry.")
except PermissionError:
    print(f"killrepl: no permission to kill pid {pid}", file=sys.stderr)
    raise SystemExit(1)

# Remove from registry so `repls` doesn't show a stale entry
del entries[root]
with open(path, "w") as handle:
    json.dump(registry, handle, indent=2)
    handle.write("\n")
PY
