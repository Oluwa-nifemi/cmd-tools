# codex-rr — convert human durations / time specs to Codex RRULE strings
#
# Usage:
#   codex-rr 5m              → one-shot ~5 min from now (pinned to clock time)
#   codex-rr 1h              → one-shot ~1 hour from now
#   codex-rr 1d2h            → one-shot ~26 hours from now
#   codex-rr 2h30m           → one-shot ~150 min from now
#   codex-rr every 30m       → recurring, clock-pinned to now+30m
#   codex-rr every 2h        → recurring, clock-pinned to now+2h
#   codex-rr every 1d        → recurring daily at current time
#   codex-rr tomorrow 2pm    → one-shot at 14:00 tomorrow
#   codex-rr mon 8am         → one-shot next Monday at 08:00
#   codex-rr friday 9:30am   → one-shot next Friday at 09:30
#   codex-rr daily 9am       → recurring daily at 09:00
#   codex-rr weekly mon 11am → recurring weekly on Monday at 11:00
#
# Time formats: 8am, 2pm, 9:30am, 2:30pm, 14:00, 09:30 (24h or 12h with am/pm)
#
# Codex requires BYHOUR/BYMINUTE/BYSECOND in every RRULE. Bare interval
# RRULEs (FREQ=MINUTELY;INTERVAL=5) are rejected as "no future runs".
# All paths emit clock-pinned RRULEs that Codex can schedule.
#
# Output goes to stdout and is copied to the clipboard (pbcopy on macOS).
# Designed for piping into Codex automation prompts.

codex-rr() {
  if [[ $# -eq 0 ]]; then
    cat <<'EOF'
usage: codex-rr <spec>

  Relative (one-shot pinned to computed clock time):
    codex-rr 5m          codex-rr 1h          codex-rr 1d2h        codex-rr 2h30m

  Recurring (clock-pinned interval):
    codex-rr every 30m   codex-rr every 2h    codex-rr every 1d

  Absolute (one-shot at a clock time):
    codex-rr tomorrow 2pm      codex-rr mon 8am       codex-rr friday 9:30am

  Recurring at a clock time:
    codex-rr daily 9am         codex-rr weekly mon 11am

  Time formats: 8am  2pm  9:30am  2:30pm  14:00  09:30
EOF
    return 1
  fi

  local rrule=""

  case "$1" in
    every)
      # "codex-rr every 30m" — recurring, clock-pinned to now + duration
      shift
      if [[ $# -eq 0 ]]; then
        echo "codex-rr: 'every' needs a duration (e.g. every 30m)" >&2
        return 1
      fi
      rrule=$(_crr_clockpinned_rrule "$1" "recurring")
      ;;

    daily)
      # "codex-rr daily 9am" — recurring daily at the given time
      shift
      local parsed_time
      parsed_time=$(_crr_parse_time "${1:-9am}") || return 1
      local hour="${parsed_time%%:*}"
      local minute="${parsed_time##*:}"
      rrule="RRULE:FREQ=DAILY;BYHOUR=${hour};BYMINUTE=${minute};BYSECOND=0"
      ;;

    weekly)
      # "codex-rr weekly mon 11am" — recurring weekly on a named day
      shift
      if [[ $# -lt 2 ]]; then
        echo "codex-rr: weekly needs a day and time (e.g. weekly mon 11am)" >&2
        return 1
      fi
      local day_abbrev
      day_abbrev=$(_crr_day_abbrev "$1") || return 1
      shift
      local parsed_time
      parsed_time=$(_crr_parse_time "${1:-9am}") || return 1
      local hour="${parsed_time%%:*}"
      local minute="${parsed_time##*:}"
      rrule="RRULE:FREQ=WEEKLY;BYDAY=${day_abbrev};BYHOUR=${hour};BYMINUTE=${minute};BYSECOND=0"
      ;;

    tomorrow|monday|tuesday|wednesday|thursday|friday|saturday|sunday|\
    mon|tue|wed|thu|fri|sat|sun)
      # "codex-rr mon 8am" / "codex-rr tomorrow 2pm" — one-shot
      local target_day="$1"
      shift
      local parsed_time
      parsed_time=$(_crr_parse_time "${1:-9am}") || return 1
      local hour="${parsed_time%%:*}"
      local minute="${parsed_time##*:}"

      if [[ "$target_day" == "tomorrow" ]]; then
        rrule="RRULE:FREQ=DAILY;COUNT=1;BYHOUR=${hour};BYMINUTE=${minute};BYSECOND=0"
      else
        local day_abbrev
        day_abbrev=$(_crr_day_abbrev "$target_day") || return 1
        rrule="RRULE:FREQ=WEEKLY;COUNT=1;BYDAY=${day_abbrev};BYHOUR=${hour};BYMINUTE=${minute};BYSECOND=0"
      fi
      ;;

    *)
      # Bare duration like "5m", "1h", "1d2h" — compute target clock time,
      # emit a one-shot RRULE pinned to that time with COUNT=1.
      rrule=$(_crr_clockpinned_rrule "$1" "oneshot")
      ;;
  esac

  if [[ -z "$rrule" ]]; then
    echo "codex-rr: failed to generate RRULE" >&2
    return 1
  fi

  echo "$rrule"

  # Copy to clipboard when pbcopy is available (macOS)
  if command -v pbcopy &>/dev/null; then
    printf '%s' "$rrule" | pbcopy
    echo "(copied to clipboard)" >&2
  fi
}

# _crr_parse_time — normalize time strings to "H:M" (no leading zeros).
# Accepts: 8am, 2pm, 9:30am, 2:30pm, 14:00, 09:30, 8, etc.
_crr_parse_time() {
  local input="${1:l}"  # lowercase for am/pm matching
  local hour=0
  local minute=0
  local pm=0

  if [[ "$input" =~ ^([0-9]{1,2}):([0-9]{2})pm$ ]]; then
    hour=${match[1]}
    minute=${match[2]}
    pm=1
  elif [[ "$input" =~ ^([0-9]{1,2}):([0-9]{2})am$ ]]; then
    hour=${match[1]}
    minute=${match[2]}
  elif [[ "$input" =~ ^([0-9]{1,2})pm$ ]]; then
    hour=${match[1]}
    minute=0
    pm=1
  elif [[ "$input" =~ ^([0-9]{1,2})am$ ]]; then
    hour=${match[1]}
    minute=0
  elif [[ "$input" =~ ^([0-9]{1,2}):([0-9]{2})$ ]]; then
    # 24-hour format like 14:00 or 09:30
    hour=${match[1]}
    minute=${match[2]}
  elif [[ "$input" =~ ^([0-9]{1,2})$ ]]; then
    # Bare hour like "8" — assume 24h
    hour=${match[1]}
    minute=0
  else
    echo "codex-rr: can't parse time '$1' (use 8am, 2:30pm, 14:00, etc.)" >&2
    return 1
  fi

  # Strip leading zeros for arithmetic
  hour=${hour#0}
  minute=${minute#0}
  [[ -z "$hour" ]] && hour=0
  [[ -z "$minute" ]] && minute=0

  # Convert 12-hour to 24-hour
  if (( pm )); then
    (( hour < 12 )) && hour=$(( hour + 12 ))
  else
    # 12am = 0 (midnight)
    if [[ "$input" == *am ]] && (( hour == 12 )); then
      hour=0
    fi
  fi

  echo "${hour}:${minute}"
}

# _crr_parse_compound_duration — parse compound durations like "1d2h30m" into
# total minutes. Supports d (days), h (hours), m (minutes). Falls back to bare
# numbers as minutes (matching ntf convention).
#
# zsh uses $MATCH / $match for regex captures (not $BASH_REMATCH), so every
# =~ block here references match[1] for the first capture group and $MATCH
# for the full matched string.
_crr_parse_compound_duration() {
  local input="$1"
  local total_minutes=0
  local remaining="$input"

  # Peel off each unit greedily: digits followed by d/h/m
  while [[ -n "$remaining" ]]; do
    if [[ "$remaining" =~ ^([0-9]+)d ]]; then
      total_minutes=$(( total_minutes + match[1] * 1440 ))
      remaining="${remaining#$MATCH}"
    elif [[ "$remaining" =~ ^([0-9]+)h ]]; then
      total_minutes=$(( total_minutes + match[1] * 60 ))
      remaining="${remaining#$MATCH}"
    elif [[ "$remaining" =~ ^([0-9]+)m ]]; then
      total_minutes=$(( total_minutes + match[1] ))
      remaining="${remaining#$MATCH}"
    elif [[ "$remaining" =~ ^([0-9]+)$ ]]; then
      # Bare number at the end — treat as minutes (same as ntf)
      total_minutes=$(( total_minutes + match[1] ))
      remaining=""
    else
      echo "codex-rr: can't parse duration '$input' (stuck at '$remaining')" >&2
      return 1
    fi
  done

  echo "$total_minutes"
}

# _crr_clockpinned_rrule — compute target time (now + duration) and emit an
# RRULE pinned to that clock time. Codex requires BYHOUR/BYMINUTE/BYSECOND
# for the scheduler to find a future occurrence.
#
# $1: compound duration string (e.g. "5m", "1d2h")
# $2: "oneshot" adds COUNT=1; "recurring" omits it
#
# Same-day targets:     FREQ=DAILY  (next occurrence of H:M is later today)
# Different-day targets: FREQ=WEEKLY;BYDAY=XX (≤7 days out)
# Durations >7 days are rejected — BYDAY can't pin beyond the current week.
_crr_clockpinned_rrule() {
  local duration="$1"
  local mode="$2"
  local total_minutes
  total_minutes=$(_crr_parse_compound_duration "$duration") || return 1

  if [[ "$total_minutes" -le 0 ]]; then
    echo "codex-rr: duration must be positive" >&2
    return 1
  fi

  if (( total_minutes > 10080 )); then
    echo "codex-rr: durations >7 days can't be pinned to a day-of-week" >&2
    return 1
  fi

  local now_epoch=$(date +%s)
  local target_epoch=$(( now_epoch + total_minutes * 60 ))
  # macOS date: -r <epoch> formats that epoch as a date
  local target_hour=$(date -r "$target_epoch" +%H)
  local target_minute=$(date -r "$target_epoch" +%M)
  local today=$(date +%Y%m%d)
  local target_date=$(date -r "$target_epoch" +%Y%m%d)

  local count_suffix=""
  [[ "$mode" == "oneshot" ]] && count_suffix=";COUNT=1"

  # Strip leading zeros for RRULE integer fields
  target_hour=${target_hour#0}
  target_minute=${target_minute#0}
  [[ -z "$target_hour" ]] && target_hour=0
  [[ -z "$target_minute" ]] && target_minute=0

  if [[ "$today" == "$target_date" ]]; then
    # Target is later today — DAILY fires at the next matching H:M
    echo "RRULE:FREQ=DAILY${count_suffix};BYHOUR=${target_hour};BYMINUTE=${target_minute};BYSECOND=0"
  else
    # Target is a different day — pin to day-of-week
    local target_dow=$(date -r "$target_epoch" +%a)
    local day_rr
    day_rr=$(_crr_day_abbrev "$target_dow") || return 1
    echo "RRULE:FREQ=WEEKLY${count_suffix};BYDAY=${day_rr};BYHOUR=${target_hour};BYMINUTE=${target_minute};BYSECOND=0"
  fi
}

# _crr_day_abbrev — map day names to RFC 5545 two-letter abbreviations
_crr_day_abbrev() {
  case "${1:l}" in
    mon|monday)    echo "MO" ;;
    tue|tuesday)   echo "TU" ;;
    wed|wednesday) echo "WE" ;;
    thu|thursday)  echo "TH" ;;
    fri|friday)    echo "FR" ;;
    sat|saturday)  echo "SA" ;;
    sun|sunday)    echo "SU" ;;
    *)
      echo "codex-rr: unknown day '$1'" >&2
      return 1
      ;;
  esac
}
