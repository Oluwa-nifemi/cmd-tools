# cm — copy a Claude Code chat session into another project directory
#
# Claude Code stores per-project session data under
#   ~/.claude/projects/<absolute-path-with-slashes-as-dashes>/
#     <session-id>.jsonl                  — main session transcript
#     <session-id>/subagents/agent-*.jsonl — subagent transcripts (when used)
#     memory/                              — project-wide memory files
# Each .jsonl embeds the absolute project path on every line, so moving a
# chat into a different working directory means (a) physically moving the
# files into the target project's dir, *and* (b) rewriting every embedded
# path. Both the main file and the sibling subagent dir need the rewrite.
#
# Usage: cm <id-or-title> <target> [--move]
#                                 Copy/move one session into <target>.
#        cm all <target> [--move]
#                                 Copy/move EVERY session from the current
#                                 project into <target>. Useful when you're
#                                 physically relocating a project on disk
#                                 and want its chat history to follow.
#        cm list [N] [any|all]    List ACP/Zed sessions, newest first
#                                 (default: 10). ACP-only by default because
#                                 these are the sessions hidden from Claude
#                                 Code's `/resume` picker — the ones you
#                                 actually need a separate tool to find.
#                                 Two filter knobs are decoupled:
#                                   `any` drops the ACP-only filter (keeps
#                                         the count limit). Use with N to
#                                         scope, e.g. `cm list any 25`.
#                                   `all` drops BOTH filters — every
#                                         session of every entrypoint,
#                                         unlimited. `cm list all` is the
#                                         "show me everything" command.
#        cm continue <id-or-title>
#                                 Resume a session in the current project
#                                 (incl. ACP sessions hidden from /resume).
#                                 Tab-completes titles and session-ids.
#        cm delete <id-or-title>... [--force]
#                                 Delete one or more sessions and their
#                                 subagent dirs from disk. Prompts once
#                                 for the whole batch unless --force is
#                                 given. If any query fails to resolve
#                                 (no match / ambiguous), the whole
#                                 batch aborts before anything is
#                                 deleted. Same per-query matcher
#                                 semantics as `cm continue`.
#
# <target> in any copy/move form accepts either:
#   - a real path (existing dir), OR
#   - an alias from the personal table near the top of cm() — see the
#     `_cm_aliases` assoc array. Aliases exist so the common "I want this
#     chat in my api/front/python project" doesn't need a full path each
#     time. Edit that table when projects move or new ones get added.
#
# Titles are the names you set with `/rename` — Claude Code stores them inline
# in the JSONL as `{"type":"custom-title","customTitle":"…"}` entries (latest
# wins). Untitled sessions show a first-user-message preview instead, and can
# only be referenced by session-id prefix.
#
# Default is duplicate (safe: original is untouched). Pass --move to delete the
# source after a successful copy.
#
# Source project is the current working directory.

cm() {
  local proj_root="$HOME/.claude/projects"

  # Personal path aliases for the <target> argument of any copy/move form.
  # These are the projects you most often migrate chats between — edit this
  # table when projects move on disk or new ones get added. Keys are matched
  # exactly; anything not in the table is treated as a literal path so the
  # general form still works.
  local -A _cm_aliases=(
    api    "$HOME/Documents/work/ardoq-api"
    front  "$HOME/Documents/work/ardoq-packages"
    python "$HOME/Documents/work/devops-monorepo"
  )

  if [[ -z "$1" || "$1" == "-h" || "$1" == "--help" ]]; then
    echo "cm — copy a Claude chat session into another project dir"
    echo ""
    echo "Usage: cm <id-or-title> <target> [--move]"
    echo "                                Copy/move ONE session from cwd into <target>"
    echo "                                (default: copy. --move to delete source)"
    echo "       cm all <target> [--move]"
    echo "                                Copy/move EVERY session from cwd into <target>"
    echo "       cm list [N] [any|all]    List ACP/Zed sessions, newest first (default: 10)"
    echo "                                'any' = drop ACP filter, keep N limit"
    echo "                                'all' = drop both filters (every session, unlimited)"
    echo "       cm continue <id-or-title>"
    echo "                                Resume a session via 'claude --resume'"
    echo "                                (incl. ACP sessions hidden from /resume picker)"
    echo "       cm delete <id-or-title>... [--force]"
    echo "                                Delete one or more sessions + subagent dirs"
    echo ""
    echo "<target> can be a path OR one of these aliases:"
    local key
    for key in "${(@k)_cm_aliases}"; do
      printf "  %-8s → %s\n" "$key" "${_cm_aliases[$key]}"
    done
    return 0
  fi

  local src_path
  src_path="$(pwd -P)"
  local src_proj="$proj_root/${src_path//\//-}"

  if [[ ! -d "$src_proj" ]]; then
    echo "cm: no Claude project dir for $src_path"
    return 1
  fi

  # Best human-readable title for a session, in precedence order:
  #   1. customTitle — set explicitly by the user via `/rename` or Zed's
  #      rename UI. Written as `{"type":"custom-title","customTitle":"…"}`.
  #   2. aiTitle     — model-generated by the auto-rename hook. Written as
  #      `{"type":"ai-title","aiTitle":"…"}`. Most sessions have one of
  #      these once the hook has fired; ACP sessions especially.
  # Returns empty when neither exists — callers fall back to a first-prompt
  # preview in that case (see the list code path).
  #
  # Latest record wins (`tail -1`) because Claude Code re-writes the title
  # record each time the hook fires; only the most recent reflects the
  # current name.
  _cm_title() {
    local title
    title=$(grep '"type":"custom-title"' "$1" 2>/dev/null | tail -1 \
      | sed -n 's/.*"customTitle":"\([^"]*\)".*/\1/p')
    if [[ -z "$title" ]]; then
      title=$(grep '"type":"ai-title"' "$1" 2>/dev/null | tail -1 \
        | sed -n 's/.*"aiTitle":"\([^"]*\)".*/\1/p')
    fi
    print -r -- "$title"
  }

  # Extract the last ISO-8601 `"timestamp":"..."` value from a session
  # file. Returns an empty string if none found.
  #
  # We use file-content timestamps (not file mtime) because mtime is
  # unreliable: `cm all --move`'s sed rewrite touches every moved file,
  # smearing every session's mtime to the moment of the move. The
  # embedded timestamps are the real "when did this conversation last
  # happen" signal.
  #
  # `tail -n 50` keeps the scan cheap on large session files; the latest
  # timestamp is virtually always in the last few lines.
  _cm_extract_iso() {
    tail -n 50 "$1" 2>/dev/null \
      | grep -o '"timestamp":"[^"]*"' \
      | tail -1 \
      | sed -E 's/.*"timestamp":"([^"]*)"/\1/'
  }

  # Format an ISO-8601 timestamp into a compact human-readable age:
  # "30s", "5m", "2h", "3d", "2w", "5mo", "1y". Largest-unit-that-fits
  # keeps the column ≤4 chars wide. Empty input → "?".
  #
  # macOS `date -j -f` parses ISO into epoch seconds. We strip the
  # fractional ".NNN" suffix and trailing "Z" because BSD date's format
  # string doesn't accept them.
  _cm_format_age() {
    local iso="$1" mtime now diff
    if [[ -n "$iso" ]]; then
      local clean="${iso%Z}"; clean="${clean%.*}"
      mtime=$(date -j -f "%Y-%m-%dT%H:%M:%S" "$clean" "+%s" 2>/dev/null)
    fi
    [[ -z "$mtime" ]] && { print -r -- "?"; return; }
    now=$(date +%s)
    diff=$(( now - mtime ))
    if   (( diff < 60       )); then print -r -- "${diff}s"
    elif (( diff < 3600     )); then print -r -- "$(( diff / 60 ))m"
    elif (( diff < 86400    )); then print -r -- "$(( diff / 3600 ))h"
    elif (( diff < 604800   )); then print -r -- "$(( diff / 86400 ))d"
    elif (( diff < 2592000  )); then print -r -- "$(( diff / 604800 ))w"
    elif (( diff < 31536000 )); then print -r -- "$(( diff / 2592000 ))mo"
    else                             print -r -- "$(( diff / 31536000 ))y"
    fi
  }

  # Backward-compat wrapper: age from a file path in one call. Used by
  # any caller that doesn't need to cache the extracted ISO.
  _cm_age() {
    _cm_format_age "$(_cm_extract_iso "$1")"
  }

  # Resolve a <target> argument to an absolute path. Returns the alias
  # expansion if it matches; otherwise returns the input unchanged. Empty
  # input returns empty so callers can detect "missing arg" themselves.
  _cm_resolve_target() {
    local input="$1"
    if [[ -n "${_cm_aliases[$input]}" ]]; then
      print -r -- "${_cm_aliases[$input]}"
    else
      print -r -- "$input"
    fi
  }

  # Migrate one session (.jsonl + matching <session-id>/ subdir if it
  # exists) from $src_proj to $dst_proj, rewriting every embedded path
  # from $src_path to $target. Sets $_cm_migrate_skipped / $_cm_migrate_ok
  # so the caller can tally results. Returns 0 on success, 1 on skip
  # (target file already exists), 2 on error.
  #
  # Why the subdir matters: Claude Code's subagent transcripts live at
  # <proj>/<session-id>/subagents/agent-*.jsonl and they also embed the
  # absolute cwd path on every line. If we move only the top-level .jsonl
  # those transcripts get orphaned (and would point at the wrong project
  # path if Claude ever picks them up again). So we move both.
  _cm_migrate_session() {
    local src_file="$1" move="$2"
    local id="${src_file:t:r}"
    local dst_file="$dst_proj/${src_file:t}"
    local d=$'\x01'
    _cm_migrate_ok=0
    _cm_migrate_skipped=0

    if [[ -e "$dst_file" ]]; then
      _cm_migrate_skipped=1
      return 1
    fi

    if ! sed "s${d}${src_path}${d}${target}${d}g" "$src_file" > "$dst_file"; then
      rm -f "$dst_file"
      return 2
    fi

    # Subagent subdir — best-effort. If it exists, rewrite each nested
    # .jsonl through sed into the mirrored location. We don't fail the
    # whole migration if a single subagent file errors out; that would
    # leave the main session half-moved.
    local sub_src="$src_proj/$id"
    if [[ -d "$sub_src" ]]; then
      local sub_dst="$dst_proj/$id"
      local nested rel nested_dst
      mkdir -p "$sub_dst"
      for nested in "$sub_src"/**/*.jsonl(N); do
        rel="${nested#$sub_src/}"
        nested_dst="$sub_dst/$rel"
        mkdir -p "${nested_dst:h}"
        sed "s${d}${src_path}${d}${target}${d}g" "$nested" > "$nested_dst" || true
      done
      if (( move )); then
        rm -rf "$sub_src"
      fi
    fi

    if (( move )); then
      rm -f "$src_file"
    fi
    _cm_migrate_ok=1
    return 0
  }

  # Print the last N "real" messages from a session file, one per line,
  # each truncated to ~110 chars with a `[user]` / `[asst]` role tag.
  # Used by `cm delete` to surface what was actually being discussed so
  # the user can spot "oh wait, this had a useful answer near the end".
  #
  # "Real" means user-typed prompts and assistant text replies — we skip:
  #   - tool-result user entries (`toolUseResult` field present)
  #   - system messages, attachments, file snapshots, etc.
  # Assistant tool_use parts are rendered as `<ToolName>` placeholders so
  # a turn that's purely tool calls is still visible (not blank).
  #
  # Python is used over jq because message.content can be a string or
  # a heterogeneous list of dicts; sed+grep can't cleanly walk that.
  _cm_tail_messages() {
    local file="$1" n="${2:-3}"
    python3 - "$file" "$n" <<'PY' 2>/dev/null
import json, sys
path, n = sys.argv[1], int(sys.argv[2])
msgs = []
with open(path) as f:
    for line in f:
        try:
            d = json.loads(line)
        except Exception:
            continue
        t = d.get('type')
        if t not in ('user', 'assistant'):
            continue
        # Skip tool-result lines — they're tagged with toolUseResult and
        # aren't conversational input.
        if t == 'user' and 'toolUseResult' in d:
            continue
        msg = d.get('message') or {}
        content = msg.get('content')
        text = ''
        if isinstance(content, str):
            text = content
        elif isinstance(content, list):
            parts = []
            for c in content:
                if not isinstance(c, dict):
                    continue
                ctype = c.get('type')
                if ctype == 'text':
                    parts.append(c.get('text', ''))
                elif ctype == 'tool_use':
                    parts.append(f"<{c.get('name', 'tool')}>")
            text = ' '.join(parts).strip()
        if not text:
            continue
        # Filter machine-injected "user" content that isn't real input:
        #   - stop-hook feedback lines from .claude/hooks/*
        #   - <system-reminder> wrappers
        #   - <local-command-caveat> wrappers from local slash commands
        # The goal is to show the human-readable tail of the conversation,
        # not the harness noise interleaved with it.
        noise_prefixes = (
            'Stop hook feedback',
            '<system-reminder',
            '<local-command-caveat',
        )
        if t == 'user' and text.lstrip().startswith(noise_prefixes):
            continue
        msgs.append(('user' if t == 'user' else 'asst', text))

for role, text in msgs[-n:]:
    snippet = ' '.join(text.split())  # collapse newlines / runs of whitespace
    if len(snippet) > 110:
        snippet = snippet[:110] + '…'
    print(f"  [{role}] {snippet}")
PY
  }

  # True when a session is "noise" — an automated one-shot SDK run rather
  # than a real conversation. These clutter `cm list` and tab-completion,
  # so we hide them. Detection is by the FIRST user-message content, which
  # is stable per category:
  #
  #   slug-gen        — stop-hook calls into the SDK to mint a kebab-case
  #                     rename. Prompt always starts with the literal
  #                     "Generate a kebab-case slug".
  #   local-command   — sessions spawned by Claude Code local slash commands
  #                     (e.g. /loop, /watch-build). The harness wraps the
  #                     user input in `<local-command-caveat>` so the model
  #                     knows it's not direct user input.
  #
  # If you add more noise sources, extend the alternation below and add a
  # comment explaining what triggers that prompt shape.
  _cm_is_noise() {
    grep -m1 '"type":"user"' "$1" 2>/dev/null | grep -qE \
      '"content":"(Generate a kebab-case slug|<local-command-caveat>)'
  }

  if [[ "$1" == "list" ]]; then
    # Two orthogonal knobs for the list view, decoupled into two keywords:
    #   filter_acp=1 (default) — only sessions with entrypoint=sdk-ts.
    #                            These are the ones /resume hides; listing
    #                            CLI sessions would mostly duplicate
    #                            what /resume already shows.
    #   limit=10     (default) — newest N rows.
    #
    #   `any` keyword: drops the ACP filter, keeps the count limit.
    #                  Use with N to scope: `cm list any 25`.
    #   `all` keyword: drops BOTH the filter AND the limit. Sugar for
    #                  "show me literally everything", which is what
    #                  you almost always want when typing 'all'.
    #   `acp` keyword: explicit no-op (default behaviour), kept for
    #                  muscle memory from the earlier API.
    #   Numeric arg:   sets the count limit. Position-independent vs
    #                  the keywords because the case branch only
    #                  changes `limit`, not the filter.
    local limit=10
    local filter_acp=1
    local arg
    for arg in "${@:2}"; do
      case "$arg" in
        any)  filter_acp=0 ;;
        all)  filter_acp=0; limit=0 ;;
        acp)  filter_acp=1 ;;
        *)    limit="$arg" ;;
      esac
    done

    local file title first_user label age shown=0
    # Sort by embedded last-message timestamp, NOT file mtime. Mtimes are
    # uniform after `cm all --move`, so we'd otherwise get every moved
    # session sharing the same "last touched" time and the list order
    # collapsing into the OS's arbitrary tiebreaker. We extract the
    # latest `"timestamp":"..."` record from each file, prepend it to
    # the path, lex-sort descending (ISO-8601 sorts chronologically as
    # a string), and stash the timestamp in an assoc array so the
    # display loop can reuse it without re-scanning the file.
    typeset -A _cm_iso_cache=()
    local -a ts_pairs=()
    local f iso
    for f in "$src_proj"/*.jsonl(N); do
      iso=$(_cm_extract_iso "$f")
      _cm_iso_cache[$f]="$iso"
      # Empty/missing timestamps sort to the bottom via epoch-zero.
      ts_pairs+=("${iso:-1970-01-01T00:00:00Z}|$f")
    done
    # (O) = reverse lex order = newest first (because ISO timestamps sort
    # chronologically as strings).
    ts_pairs=("${(@O)ts_pairs}")
    local -a files=()
    for f in "${ts_pairs[@]}"; do
      files+=("${f#*|}")
    done
    # We iterate the full sorted list and stop after `limit` *displayed*
    # matches. We can't pre-slice to `limit` items: the noise filter and
    # the optional ACP filter both reject files post-sort, so a
    # pre-slice would silently show fewer than `limit` entries.

    # Tabular output: header + 3 columns (TITLE, ID prefix, AGE).
    # Order is TITLE first because that's what the eye looks for; ID and
    # AGE are reference data, parked on the right.
    #   - TITLE is padded to TITLE_WIDTH (50) for a clean column. Long
    #     labels truncate with a single-char ellipsis. Most kebab-case
    #     titles sit comfortably under 40 chars; the first-prompt
    #     fallback previews are the ones that get clipped here.
    #   - ID shows the 8-char UUID prefix — enough to feed back into
    #     `cm continue` / `cm delete` via the prefix matcher.
    #   - AGE column width is 4 ("99mo" fits, anything bigger is a year).
    #   - Header is dimmed via ANSI SGR 2 so it sits visually behind the
    #     data rows. Suppressed when stdout isn't a TTY (e.g. piped into
    #     `wc -l` or grep) so the header doesn't pollute scripted use.
    local TITLE_WIDTH=50
    local fmt="%-${TITLE_WIDTH}s  %-8s  %-4s\n"
    if [[ -t 1 ]]; then
      printf "\e[2m${fmt}\e[0m" 'TITLE' 'ID' 'AGE'
    fi

    for file in "${files[@]}"; do
      # ACP/Zed sessions are tagged `"entrypoint":"sdk-ts"` on every assistant
      # message. -q exits at the first hit so large files stay cheap.
      if (( filter_acp )) && ! grep -q '"entrypoint":"sdk-ts"' "$file"; then
        continue
      fi
      # Hide automated/noise sessions (slug-gen hooks, local-command
      # wrappers) — see `_cm_is_noise` for the full taxonomy.
      _cm_is_noise "$file" && continue
      title="$(_cm_title "$file")"
      if [[ -n "$title" ]]; then
        label="$title"
      else
        # No title — fall back to the first user message. Grab up to 120
        # chars; final truncation to TITLE_WIDTH happens below for ALL
        # labels (title or preview), so this is just buffer for whatever
        # we'll display in the column.
        first_user="$(grep -m1 '"type":"user"' "$file" 2>/dev/null \
          | sed -n 's/.*"content":"\([^"]\{0,120\}\).*/\1/p')"
        label="${first_user:-(no preview)}"
      fi
      # Single truncation point so titles and previews both fit cleanly
      # into the TITLE column. Anything longer gets one trailing ellipsis.
      if (( ${#label} > TITLE_WIDTH )); then
        label="${label:0:$((TITLE_WIDTH - 1))}…"
      fi
      # Reuse the ISO we extracted during the sort pass — no second
      # tail/grep on the same file.
      age="$(_cm_format_age "${_cm_iso_cache[$file]}")"
      local id_short="${${file:t:r}:0:8}"
      printf "$fmt" "$label" "$id_short" "$age"
      (( shown++ ))
      if (( limit > 0 && shown >= limit )); then
        break
      fi
    done
    return 0
  fi

  # Resolve a query (id-prefix, exact title, or substring title) to a single
  # session file. Sets the global-to-the-function `_cm_match` on success.
  # Returns nonzero on no-match or ambiguous match (printing diagnostics).
  _cm_match_session() {
    local q="$1" file title
    _cm_match=""
    local -a hits=()
    for file in "$src_proj"/*.jsonl(N); do
      [[ "$(basename "$file" .jsonl)" == "$q"* ]] && hits+=("$file")
    done
    if [[ ${#hits[@]} -eq 0 ]]; then
      for file in "$src_proj"/*.jsonl(N); do
        title="$(_cm_title "$file")"
        [[ "$title" == "$q" ]] && hits+=("$file")
      done
    fi
    if [[ ${#hits[@]} -eq 0 ]]; then
      for file in "$src_proj"/*.jsonl(N); do
        title="$(_cm_title "$file")"
        [[ -n "$title" && "$title" == *"$q"* ]] && hits+=("$file")
      done
    fi
    if [[ ${#hits[@]} -eq 0 ]]; then
      echo "cm: no session matching '$q' in $src_proj"
      return 1
    elif [[ ${#hits[@]} -gt 1 ]]; then
      echo "cm: '$q' matches multiple sessions:"
      for file in "${hits[@]}"; do
        echo "  $(basename "$file" .jsonl)"
      done
      echo "Narrow the query (e.g. pass the session id prefix)."
      return 1
    fi
    _cm_match="${hits[1]}"
    return 0
  }

  if [[ "$1" == "continue" ]]; then
    if [[ -z "$2" ]]; then
      echo "Usage: cm continue <id-or-title>"
      return 1
    fi
    local _cm_match
    _cm_match_session "$2" || return 1
    local session_id="$(basename "$_cm_match" .jsonl)"
    # `claude --resume <id>` bypasses the picker, so SDK-entrypoint sessions
    # (Zed/ACP) resume even though /resume hides them. cwd is already the
    # session's project, since we matched against $src_proj.
    #
    # We deliberately DO NOT use `exec` here. `exec` would replace the
    # shell process with claude, so when claude exits there's no shell
    # left and the terminal closes the pane (or sits in a "[Process
    # completed]" zombie state needing Ctrl-C to recover). Letting it
    # run as a child means the shell unblocks naturally on exit and the
    # prompt comes back.
    #
    # The `return` after the call is load-bearing: without `exec` to
    # terminate the function, control would otherwise fall through into
    # the copy-command path below and reinterpret args as a copy target.
    claude --resume "$session_id"
    return $?
  fi

  # `cm delete <id-or-title>... [--force]` — destructive remove of one or
  # more sessions. Default is interactive: prints what will be deleted
  # (including last 3 conversational turns per session) and asks a single
  # y/N for the whole batch. --force / -f skips the prompt.
  #
  # All queries are resolved up-front via `_cm_match_session`. If ANY of
  # them fail to resolve (no match / ambiguous), nothing is deleted —
  # bulk operations on a half-resolved set are too easy to misuse.
  # Duplicate matches across queries are deduped so passing the same id
  # twice doesn't double-delete or weirdly fail on the second pass.
  #
  # We deliberately do NOT support `cm delete all` or glob patterns —
  # nuking everything matching a wildcard is exactly the class of
  # mistake that motivated the per-session confirmation in the first
  # place.
  if [[ "$1" == "delete" ]]; then
    if [[ -z "$2" ]]; then
      echo "Usage: cm delete <id-or-title>... [--force]"
      return 1
    fi

    local force=0 arg
    local -a queries=()
    # Split args into flags vs queries. Treat anything starting with `-`
    # as a flag; unknown flags fall through to the default error path.
    for arg in "${@:2}"; do
      case "$arg" in
        --force|-f) force=1 ;;
        -*)
          echo "cm: unknown flag '$arg' (delete accepts --force/-f)"
          return 1
          ;;
        *)          queries+=("$arg") ;;
      esac
    done

    if (( ${#queries[@]} == 0 )); then
      echo "Usage: cm delete <id-or-title>... [--force]"
      return 1
    fi

    # Resolve every query first; abort on any failure before deleting
    # anything. Dedupe by absolute file path so passing the same target
    # twice is harmless.
    local -a targets=()  # absolute paths to .jsonl files
    local q _cm_match seen
    for q in "${queries[@]}"; do
      _cm_match_session "$q" || return 1
      seen=0
      for arg in "${targets[@]}"; do
        [[ "$arg" == "$_cm_match" ]] && { seen=1; break; }
      done
      (( seen )) || targets+=("$_cm_match")
    done

    local plural
    (( ${#targets[@]} == 1 )) && plural="session" || plural="sessions"
    echo "Will delete ${#targets[@]} $plural:"
    local file id title sub_dir sub_count idx=0
    for file in "${targets[@]}"; do
      idx=$(( idx + 1 ))
      id="${file:t:r}"
      title="$(_cm_title "$file")"
      sub_dir="$src_proj/$id"
      echo ""
      echo "  [$idx] $id"
      [[ -n "$title" ]] && echo "       title: $title"
      if [[ -d "$sub_dir" ]]; then
        sub_count=$(find "$sub_dir" -name "*.jsonl" 2>/dev/null | wc -l | tr -d " ")
        echo "       subagent dir: $sub_count file(s)"
      fi
      echo "       last 3 messages:"
      _cm_tail_messages "$file" 3 | sed 's/^  /       /'
    done
    echo ""

    if (( ! force )); then
      local reply prompt
      if (( ${#targets[@]} == 1 )); then
        prompt="Delete this session? [y/N] "
      else
        prompt="Delete all ${#targets[@]} sessions? [y/N] "
      fi
      read -r "reply?$prompt"
      if [[ "$reply" != "y" && "$reply" != "Y" ]]; then
        echo "aborted"
        return 1
      fi
    fi

    # Perform deletes. Track failures so the user sees a summary even if
    # one rm fails partway through (e.g. permission glitch on a single
    # subagent dir).
    local deleted=0 failed=0
    for file in "${targets[@]}"; do
      id="${file:t:r}"
      sub_dir="$src_proj/$id"
      if ! rm -f "$file"; then
        echo "cm: failed to remove $file"
        failed=$(( failed + 1 ))
        continue
      fi
      [[ -d "$sub_dir" ]] && rm -rf "$sub_dir"
      deleted=$(( deleted + 1 ))
    done
    (( deleted == 1 )) && plural="session" || plural="sessions"
    echo "deleted $deleted $plural"
    (( failed > 0 )) && echo "failed $failed"
    return 0
  fi

  # `cm all <target> [--move]` — bulk migrate every session in the current
  # project dir. Use case: you're moving a project on disk and want its
  # full chat history to follow. Defaults to copy (safe); --move deletes
  # the source after a successful migration. The project-wide `memory/`
  # dir (if present) is treated as a single unit and moved alongside.
  if [[ "$1" == "all" ]]; then
    local target="$2"
    local move=0
    local arg
    for arg in "${@:3}"; do
      [[ "$arg" == "--move" ]] && move=1
    done

    if [[ -z "$target" ]]; then
      echo "Usage: cm all <target-or-alias> [--move]"
      return 1
    fi
    target="$(_cm_resolve_target "$target")"
    if [[ ! -d "$target" ]]; then
      echo "cm: target path does not exist: $target"
      return 1
    fi
    target="$(cd "$target" && pwd -P)"
    if [[ "$target" == "$src_path" ]]; then
      echo "cm: source and target are the same path"
      return 1
    fi
    local dst_proj="$proj_root/${target//\//-}"
    mkdir -p "$dst_proj"

    local copied=0 skipped=0 failed=0
    local src_file _cm_migrate_ok _cm_migrate_skipped rc
    for src_file in "$src_proj"/*.jsonl(N); do
      _cm_migrate_session "$src_file" "$move"
      rc=$?
      case $rc in
        0) copied=$(( copied + 1 )) ;;
        1) skipped=$(( skipped + 1 )) ;;
        *) failed=$(( failed + 1 )); echo "cm: failed to migrate ${src_file:t}" ;;
      esac
    done

    # Project-wide memory dir — not session-specific. Move/copy as a
    # single unit if it exists. No path rewriting needed because memory
    # files are plain markdown without embedded absolute paths.
    if [[ -d "$src_proj/memory" ]]; then
      if [[ -d "$dst_proj/memory" ]]; then
        echo "cm: $dst_proj/memory already exists — leaving source memory dir intact"
      else
        cp -R "$src_proj/memory" "$dst_proj/memory" \
          && { (( move )) && rm -rf "$src_proj/memory"; }
      fi
    fi

    local verb; (( move )) && verb="Moved" || verb="Copied"
    echo "$verb $copied session(s) → $dst_proj"
    (( skipped > 0 )) && echo "Skipped $skipped (already existed in target)"
    (( failed > 0 ))  && echo "Failed $failed"
    return 0
  fi

  local query="$1"
  local target="$2"
  local move=0
  for arg in "${@:3}"; do
    [[ "$arg" == "--move" ]] && move=1
  done

  if [[ -z "$target" ]]; then
    echo "Usage: cm <id-or-title> <target-or-alias> [--move]"
    return 1
  fi

  # Resolve target via alias table first, then verify it's an existing
  # directory. We never create project dirs out of thin air — `<target>`
  # must already exist on disk.
  target="$(_cm_resolve_target "$target")"
  if [[ ! -d "$target" ]]; then
    echo "cm: target path does not exist: $target"
    return 1
  fi
  target="$(cd "$target" && pwd -P)"
  if [[ "$target" == "$src_path" ]]; then
    echo "cm: source and target are the same path"
    return 1
  fi
  local dst_proj="$proj_root/${target//\//-}"

  local _cm_match
  _cm_match_session "$query" || return 1
  local src_file="$_cm_match"
  mkdir -p "$dst_proj"

  local _cm_migrate_ok _cm_migrate_skipped
  _cm_migrate_session "$src_file" "$move"
  local rc=$?
  if (( rc == 1 )); then
    echo "cm: $dst_proj/${src_file:t} already exists — refusing to overwrite"
    return 1
  elif (( rc != 0 )); then
    echo "cm: failed to migrate ${src_file:t}"
    return 1
  fi

  local verb; (( move )) && verb="Moved" || verb="Copied"
  echo "$verb session → $dst_proj/${src_file:t}"
}

# zsh completion. Only registers when running under zsh and the completion
# system is loaded (compdef present). For `cm continue`, completes session
# titles (preferred) and session-ids from the current project dir, newest
# first. For `cm <id-or-title>` (the copy form) it offers the same.
if [[ -n "$ZSH_VERSION" ]] && (( $+functions[compdef] )); then
  _cm() {
    local proj_root="$HOME/.claude/projects"
    local src_proj="$proj_root/${PWD//\//-}"

    _cm_complete_sessions() {
      [[ -d "$src_proj" ]] || return
      local -a entries
      local file id title age mtime now diff
      now=$(date +%s)
      # One entry per session, mtime-sorted (newest first). The "value" that
      # gets inserted on Tab is the title when present, else the session-id.
      # Description shows age + the 8-char id prefix (or "(untitled)").
      #
      # We deliberately do NOT emit two entries per session (one keyed by
      # title, one by id) — that listed each session twice, which the user
      # flagged as noisy. Loss: typing an id-prefix no longer completes a
      # titled session. Fine: `cm continue <full-id>` still works directly.
      #
      # `_cm_title` and `_cm_age` are scoped inside `cm()` and not reachable
      # from this completion function, so the title-precedence logic and
      # the age-bucketing are duplicated below. KEEP IN SYNC.
      for file in "$src_proj"/*.jsonl(Nom); do
        # Noise filter — KEEP IN SYNC with `_cm_is_noise` inside cm().
        grep -m1 '"type":"user"' "$file" 2>/dev/null | grep -qE \
          '"content":"(Generate a kebab-case slug|<local-command-caveat>)' \
          && continue
        id="${file:t:r}"
        title=$(grep '"type":"custom-title"' "$file" 2>/dev/null | tail -1 \
          | sed -n 's/.*"customTitle":"\([^"]*\)".*/\1/p')
        if [[ -z "$title" ]]; then
          title=$(grep '"type":"ai-title"' "$file" 2>/dev/null | tail -1 \
            | sed -n 's/.*"aiTitle":"\([^"]*\)".*/\1/p')
        fi
        # Inline age bucket — same thresholds as `_cm_age`.
        mtime=$(stat -f %m "$file" 2>/dev/null) || mtime=$now
        diff=$(( now - mtime ))
        if   (( diff < 60       )); then age="${diff}s"
        elif (( diff < 3600     )); then age="$(( diff / 60 ))m"
        elif (( diff < 86400    )); then age="$(( diff / 3600 ))h"
        elif (( diff < 604800   )); then age="$(( diff / 86400 ))d"
        elif (( diff < 2592000  )); then age="$(( diff / 604800 ))w"
        elif (( diff < 31536000 )); then age="$(( diff / 2592000 ))mo"
        else                             age="$(( diff / 31536000 ))y"
        fi
        # `_describe` parses each item as "value:description". The colon is
        # the separator; titles are kebab-case and ids are UUIDs, so the
        # value side never contains a colon. Format the description as
        # "<age> • <id-prefix-or-untitled>" so both bits read cleanly.
        if [[ -n "$title" ]]; then
          entries+=("${title}:${age} • ${id:0:8}")
        else
          entries+=("${id}:${age} • (untitled)")
        fi
      done
      _describe -t sessions 'session' entries
    }

    local context state line
    _arguments -C \
      '1: :->cmd' \
      '*::: :->args' && return 0

    # Alias keywords — KEEP IN SYNC with the `_cm_aliases` table inside
    # cm(). Completion lives outside the cm() function scope, so the table
    # isn't reachable from here; values mirrored as plain descriptions.
    _cm_alias_targets() {
      _values 'target alias' \
        'api[~/Documents/work/ardoq-api]' \
        'front[~/Documents/work/ardoq-packages]' \
        'python[~/Desktop/devops-monorepo]'
    }

    case $state in
      cmd)
        local -a cmds
        cmds=(
          'list:list sessions in current project'
          'continue:resume a session (incl. Zed/ACP)'
          'delete:delete a session from disk'
          'all:copy/move every session into <target>'
        )
        _describe 'command' cmds
        _cm_complete_sessions
        ;;
      args)
        case $line[1] in
          continue|delete) _cm_complete_sessions ;;
          list)
            _values 'list option' \
              'any[drop ACP-only filter, keep count limit]' \
              'all[every session, unlimited]'
            ;;
          all)
            # `cm all <target>` — second word is the target. Offer aliases
            # alongside path completion.
            if (( CURRENT == 2 )); then
              _cm_alias_targets
              _path_files -/
            fi
            ;;
          *)
            # `cm <id-or-title> <target>` — second word is the target.
            if (( CURRENT == 2 )); then
              _cm_alias_targets
              _path_files -/
            fi
            ;;
        esac
        ;;
    esac
  }
  compdef _cm cm
fi
