#!/usr/bin/env bash

# gs (git-stack) — stacked branch workflow tool
#
# Inspired by Graphite (graphite.dev) which provides a stacked PR workflow.
# Key difference: Graphite treats each branch as a single commit that gets
# amended via `gt modify`. We don't like that — branches here can have
# multiple commits, and `gs commit` simply adds a new commit then rebases
# all upstack (child) branches to propagate the change.
#
# Metadata lives in .git/gs/ — a config file for trunk and a branches/
# directory where each file maps a branch to its parent. That's it.
# Branch names with slashes are URL-encoded (%2F) for safe filesystem use.
#
# Core workflow:
#   gs init                 → set up tracking in a repo
#   gs create <name>        → new branch stacked on current
#   gs commit -m "msg"      → commit + auto-restack upstack branches
#   gs track b1 b2 b3       → retroactively stack existing branches
#   gs ls / gs log           → visualize the stack
#   gs up / gs down          → navigate the stack
#   gs restack               → manual rebase propagation (for when you
#                              use raw git commands instead of gs commit)
#
# This file is meant to grow over time. Keep commands as functions (cmd_*)
# and add new ones to the dispatch table in main() at the bottom.

set -eo pipefail

# ── Colors ──────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

# ── Helpers ─────────────────────────────────────────────────────────────────

die() {
  printf "${RED}error:${RESET} %s\n" "$*" >&2
  exit 1
}

info() {
  printf "${CYAN}%s${RESET}\n" "$*"
}

warn() {
  printf "${YELLOW}warning:${RESET} %s\n" "$*" >&2
}

success() {
  printf "${GREEN}%s${RESET}\n" "$*"
}

ensure_git_repo() {
  git rev-parse --git-dir &>/dev/null || die "not a git repository"
}

git_dir() {
  git rev-parse --git-dir
}

gs_dir() {
  echo "$(git_dir)/gs"
}

ensure_gs_init() {
  ensure_git_repo
  local d
  d="$(gs_dir)"
  [[ -d "$d" ]] || die "gs is not initialized in this repo. Run 'gs init' first."
}

current_branch() {
  git symbolic-ref --short HEAD 2>/dev/null || die "HEAD is detached"
}

trunk_branch() {
  cat "$(gs_dir)/config" 2>/dev/null || die "cannot read trunk config"
}

branch_exists() {
  git show-ref --verify --quiet "refs/heads/$1" 2>/dev/null
}

# Encode branch name for safe filesystem use (/ -> %2F)
encode_branch() {
  echo "$1" | sed 's/%/%25/g; s|/|%2F|g'
}

# Decode branch name from filesystem (%2F -> /)
decode_branch() {
  echo "$1" | sed 's|%2F|/|g; s/%25/%/g'
}

is_tracked() {
  [[ -f "$(gs_dir)/branches/$(encode_branch "$1")" ]]
}

get_parent() {
  local f
  f="$(gs_dir)/branches/$(encode_branch "$1")"
  [[ -f "$f" ]] && cat "$f" || return 1
}

set_parent() {
  # $1 = branch, $2 = parent
  echo "$2" > "$(gs_dir)/branches/$(encode_branch "$1")"
}

remove_tracking() {
  rm -f "$(gs_dir)/branches/$(encode_branch "$1")"
}

# Return all tracked children of a branch
get_children() {
  local parent="$1"
  local dir
  dir="$(gs_dir)/branches"
  [[ -d "$dir" ]] || return 0
  for f in "$dir"/*; do
    [[ -f "$f" ]] || continue
    local encoded_child
    encoded_child="$(basename "$f")"
    local child
    child="$(decode_branch "$encoded_child")"
    if [[ "$(cat "$f")" == "$parent" ]]; then
      echo "$child"
    fi
  done
}

# Count commits on a branch relative to its parent
count_commits() {
  local branch="$1"
  local parent
  parent="$(get_parent "$branch" 2>/dev/null)" || return 0
  git rev-list --count "$parent".."$branch" 2>/dev/null || echo 0
}

# ── Commands ────────────────────────────────────────────────────────────────

# Set up gs in a repo. Creates .git/gs/ dir and records which branch is trunk.
cmd_init() {
  ensure_git_repo
  local d
  d="$(gs_dir)"

  if [[ -d "$d" ]]; then
    warn "gs is already initialized in this repo"
    info "trunk: $(trunk_branch)"
    return 0
  fi

  local trunk=""
  # Check for explicit argument
  if [[ ${1:-} == "--trunk" ]] && [[ -n ${2:-} ]]; then
    trunk="$2"
  else
    # Auto-detect
    for candidate in main master; do
      if branch_exists "$candidate"; then
        trunk="$candidate"
        break
      fi
    done
  fi

  if [[ -z "$trunk" ]]; then
    die "could not detect trunk branch. Use: gs init --trunk <branch>"
  fi

  mkdir -p "$d/branches"
  echo "$trunk" > "$d/config"
  success "initialized gs with trunk branch '$trunk'"
}

# Create a new branch stacked on the current one. Optionally commit staged changes.
# Auto-tracks the parent if it wasn't already tracked.
cmd_create() {
  ensure_gs_init
  local name=""
  local message=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -m) shift; message="${1:-}"; [[ -z "$message" ]] && die "-m requires a message" ;;
      -*) die "unknown flag: $1" ;;
      *)  name="$1" ;;
    esac
    shift
  done

  [[ -z "$name" ]] && die "usage: gs create <name> [-m \"message\"]"
  branch_exists "$name" && die "branch '$name' already exists"

  local parent
  parent="$(current_branch)"

  git checkout -b "$name" --quiet
  set_parent "$name" "$parent"

  # Also track parent if it's not trunk and not yet tracked
  local trunk
  trunk="$(trunk_branch)"
  if [[ "$parent" != "$trunk" ]] && ! is_tracked "$parent"; then
    set_parent "$parent" "$trunk"
    info "auto-tracked parent '$parent' onto '$trunk'"
  fi

  if [[ -n "$message" ]]; then
    git commit -m "$message" --allow-empty --quiet 2>/dev/null || git commit -m "$message" --quiet
  fi

  success "created branch '$name' stacked on '$parent'"
}

# Retroactively add existing branches to a stack. List them bottom-to-top.
# First branch stacks onto trunk (or --onto target), each subsequent one stacks on the previous.
cmd_track() {
  ensure_gs_init
  local onto=""
  local branches=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --onto) shift; onto="${1:-}"; [[ -z "$onto" ]] && die "--onto requires a branch name" ;;
      -*) die "unknown flag: $1" ;;
      *)  branches+=("$1") ;;
    esac
    shift
  done

  [[ ${#branches[@]} -eq 0 ]] && die "usage: gs track <branch1> [branch2] ... [--onto <branch>]"

  local trunk
  trunk="$(trunk_branch)"
  local parent="${onto:-$trunk}"

  # Validate parent
  if [[ "$parent" != "$trunk" ]] && ! branch_exists "$parent"; then
    die "branch '$parent' does not exist"
  fi

  for b in "${branches[@]}"; do
    branch_exists "$b" || die "branch '$b' does not exist"
    set_parent "$b" "$parent"
    info "tracked '$b' onto '$parent'"
    parent="$b"
  done

  success "tracked ${#branches[@]} branch(es)"
}

# Add an existing branch on top of the current one. No flags needed.
cmd_stack() {
  ensure_gs_init
  local branch="${1:-}"
  [[ -z "$branch" ]] && die "usage: gs stack <branch>"
  branch_exists "$branch" || die "branch '$branch' does not exist"

  local cur
  cur="$(current_branch)"
  set_parent "$branch" "$cur"
  success "stacked '$branch' onto '$cur'"
}

# Commit to the current branch, then auto-rebase all upstack branches.
# This is the key difference from Graphite: we add commits, not amend them.
# All flags are passed through to git commit.
cmd_commit() {
  ensure_gs_init
  local args=()
  local has_message=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -m) has_message=true; args+=("$1"); shift; args+=("${1:-}") ;;
      *)  args+=("$1") ;;
    esac
    shift
  done

  git commit "${args[@]}"

  # Save the pre-commit tip (HEAD^) so restack_upstack has a reliable fork
  # point for our children. Without this, the first level of recursion falls
  # into the merge-base fallback, which can over-collect commits when our
  # branch already had history rewritten upstream.
  local cur tips_dir
  cur="$(current_branch)"
  tips_dir="$(gs_dir)/old_tips"
  mkdir -p "$tips_dir"
  git rev-parse HEAD^ > "$tips_dir/$(encode_branch "$cur")" 2>/dev/null || true

  info "restacking upstack branches..."
  restack_upstack "$cur"
  cleanup_restack_tips
  success "commit done and upstack restacked"
}

# Manual rebase propagation. Use this when you've made changes with raw git
# commands instead of gs commit. --all restacks the entire stack from trunk.
# --continue resumes after resolving a rebase conflict.
cmd_restack() {
  ensure_gs_init
  local mode="upstack"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --upstack) mode="upstack" ;;
      --all)     mode="all" ;;
      --continue) restack_continue; return ;;
      *) die "unknown argument: $1" ;;
    esac
    shift
  done

  if [[ "$mode" == "all" ]]; then
    local trunk
    trunk="$(trunk_branch)"
    restack_upstack "$trunk"
  else
    restack_upstack "$(current_branch)"
  fi
  cleanup_restack_tips
  success "restack complete"
}

# Core restack engine: recursively rebase each child onto its parent, depth-first.
# On conflict, saves state to .git/gs/restack_state for --continue to resume.
#
# The tricky part: after rebasing child A onto parent P, A has new commit hashes.
# If A has its own children, they still reference A's OLD commits. So we can't
# use merge-base to find the fork point — it'll go too far back.
# Instead, we save each branch's old tip BEFORE rebasing, and use that as the
# fork point for its children. This is stored in .git/gs/old_tips/<branch>.
restack_upstack() {
  local base="$1"
  local children
  children="$(get_children "$base")"

  local original_branch
  original_branch="$(current_branch)"

  local tips_dir
  tips_dir="$(gs_dir)/old_tips"
  mkdir -p "$tips_dir"

  for child in $children; do
    branch_exists "$child" || continue

    # Determine the fork point: if we previously rebased the parent and saved
    # its old tip, use that. Otherwise fall back to merge-base.
    local fork_point=""
    local old_tip_file="$tips_dir/$(encode_branch "$base")"
    if [[ -f "$old_tip_file" ]]; then
      # Parent was rebased — child is still based on parent's old commits.
      # The old tip of the parent is the correct fork point.
      fork_point="$(cat "$old_tip_file")"
    else
      # No saved old-tip for the parent. This happens when the user mutated
      # the parent's history with raw git (rebase / reset / amend) before
      # invoking `gs restack`. merge-base may go further back than the real
      # fork — if the parent had its commits rewritten with new SHAs, the
      # rebase can pick up duplicates of commits that already exist on the
      # new parent. We surface this rather than silently producing duplicates.
      fork_point="$(git merge-base "$base" "$child" 2>/dev/null)" || fork_point="$base"
      warn "no saved old-tip for '$base' (gs commit wasn't used). Falling back to merge-base. If '$base' was rebased, the upstack rebase may include duplicate commits or hit unexpected conflicts."
    fi

    # Skip if child is already up to date
    local child_tip
    child_tip="$(git rev-parse "$child" 2>/dev/null)"
    local base_tip
    base_tip="$(git rev-parse "$base" 2>/dev/null)"
    if [[ "$fork_point" == "$base_tip" ]] || [[ "$child_tip" == "$base_tip" ]]; then
      info "'$child' is already up to date with '$base'"
      restack_upstack "$child"
      continue
    fi

    # Save child's current tip before rebasing (its children will need this)
    echo "$child_tip" > "$tips_dir/$(encode_branch "$child")"

    info "rebasing '$child' onto '$base'..."

    if ! git rebase --onto "$base" "$fork_point" "$child" --quiet 2>/dev/null; then
      # Conflict detected — save state for --continue
      local state_file
      state_file="$(gs_dir)/restack_state"
      {
        echo "child=$child"
        echo "base=$base"
        echo "original=$original_branch"
      } > "$state_file"
      printf "\n${RED}conflict detected${RESET} while rebasing '${YELLOW}$child${RESET}' onto '${YELLOW}$base${RESET}'\n"
      echo "Resolve conflicts, stage files, then run: gs restack --continue"
      exit 1
    fi

    # Recurse into children of child
    restack_upstack "$child"
  done

  # Return to original branch if we're still on it
  if [[ "$(current_branch)" != "$original_branch" ]] && branch_exists "$original_branch"; then
    git checkout "$original_branch" --quiet 2>/dev/null || true
  fi
}

# Clean up old_tips after a full restack completes
cleanup_restack_tips() {
  rm -rf "$(gs_dir)/old_tips"
}

restack_continue() {
  local state_file
  state_file="$(gs_dir)/restack_state"
  [[ -f "$state_file" ]] || die "no restack in progress"

  # Source the state
  local child base original
  eval "$(cat "$state_file")"

  # Continue the rebase
  if ! git rebase --continue; then
    echo "Still have conflicts. Resolve them and run 'gs restack --continue' again."
    exit 1
  fi

  rm -f "$state_file"

  # Continue restacking children of the child we just rebased
  restack_upstack "$child"

  # Return to original branch
  if branch_exists "$original"; then
    git checkout "$original" --quiet 2>/dev/null || true
  fi

  cleanup_restack_tips
  success "restack continued and completed"
}

# Show the stack as a tree with branch names and commit counts.
cmd_ls() {
  ensure_gs_init
  local trunk
  trunk="$(trunk_branch)"
  local cur
  cur="$(current_branch)"

  echo -e "${BOLD}${YELLOW}$trunk${RESET}"
  print_tree "$trunk" "" "$cur"
}

# Recursive tree printer
# $1 = parent branch, $2 = prefix for indentation, $3 = current branch
print_tree() {
  local parent="$1"
  local prefix="$2"
  local cur="$3"

  local children=()
  while IFS= read -r c; do
    [[ -n "$c" ]] && children+=("$c")
  done <<< "$(get_children "$parent")"

  local count=${#children[@]}
  local i=0

  for child in "${children[@]}"; do
    i=$((i + 1))
    local connector="├── "
    local child_prefix="${prefix}│   "
    if [[ $i -eq $count ]]; then
      connector="└── "
      child_prefix="${prefix}    "
    fi

    local commits
    commits="$(count_commits "$child")"
    local marker=""
    if [[ "$child" == "$cur" ]]; then
      marker=" ${GREEN}← you are here${RESET}"
    fi

    local color="${YELLOW}"
    if [[ "$child" == "$cur" ]]; then
      color="${GREEN}${BOLD}"
    fi

    echo -e "${prefix}${connector}${color}${child}${RESET} ${DIM}(${commits} commit$([ "$commits" != "1" ] && echo "s"))${RESET}${marker}"
    print_tree "$child" "$child_prefix" "$cur"
  done
}

# Show the stack tree with individual commit hashes and messages per branch.
cmd_log() {
  ensure_gs_init
  local trunk
  trunk="$(trunk_branch)"
  local cur
  cur="$(current_branch)"

  echo -e "${BOLD}${YELLOW}$trunk${RESET}"
  print_log_tree "$trunk" "" "$cur"
}

print_log_tree() {
  local parent="$1"
  local prefix="$2"
  local cur="$3"

  local children=()
  while IFS= read -r c; do
    [[ -n "$c" ]] && children+=("$c")
  done <<< "$(get_children "$parent")"

  local count=${#children[@]}
  local i=0

  for child in "${children[@]}"; do
    i=$((i + 1))
    local connector="├── "
    local child_prefix="${prefix}│   "
    if [[ $i -eq $count ]]; then
      connector="└── "
      child_prefix="${prefix}    "
    fi

    local marker=""
    if [[ "$child" == "$cur" ]]; then
      marker=" ${GREEN}← you are here${RESET}"
    fi

    local color="${YELLOW}"
    if [[ "$child" == "$cur" ]]; then
      color="${GREEN}${BOLD}"
    fi

    echo -e "${prefix}${connector}${color}${child}${RESET}${marker}"

    # Show commits on this branch
    local parent_branch
    parent_branch="$(get_parent "$child" 2>/dev/null)" || parent_branch="$parent"
    local commits
    commits="$(git log --oneline "$parent_branch".."$child" 2>/dev/null)" || commits=""
    if [[ -n "$commits" ]]; then
      while IFS= read -r line; do
        local hash msg
        hash="${line%% *}"
        msg="${line#* }"
        echo -e "${child_prefix}${DIM}${BLUE}$hash${RESET} ${DIM}$msg${RESET}"
      done <<< "$commits"
    fi

    print_log_tree "$child" "$child_prefix" "$cur"
  done
}

# Navigate up (toward children). Prompts if multiple children exist.
cmd_up() {
  ensure_gs_init
  local steps="${1:-1}"
  local cur
  cur="$(current_branch)"

  for ((s = 0; s < steps; s++)); do
    local children=()
    while IFS= read -r c; do
      [[ -n "$c" ]] && children+=("$c")
    done <<< "$(get_children "$cur")"

    if [[ ${#children[@]} -eq 0 ]]; then
      die "no child branches above '$(current_branch)'"
    elif [[ ${#children[@]} -eq 1 ]]; then
      cur="${children[0]}"
    else
      echo "Multiple children of '$(current_branch)':"
      local idx=1
      for c in "${children[@]}"; do
        echo "  $idx) $c"
        idx=$((idx + 1))
      done
      printf "Pick [1-%d]: " "${#children[@]}"
      read -r choice
      choice=$((choice - 1))
      if [[ $choice -lt 0 ]] || [[ $choice -ge ${#children[@]} ]]; then
        die "invalid choice"
      fi
      cur="${children[$choice]}"
    fi
  done

  git checkout "$cur" --quiet
  success "switched to '$cur'"
}

# Navigate down (toward parent/trunk).
cmd_down() {
  ensure_gs_init
  local steps="${1:-1}"
  local cur
  cur="$(current_branch)"

  for ((s = 0; s < steps; s++)); do
    local parent
    parent="$(get_parent "$cur" 2>/dev/null)" || die "'$cur' has no tracked parent"
    cur="$parent"
  done

  git checkout "$cur" --quiet
  success "switched to '$cur'"
}

# Jump to the topmost branch in the current stack path. Follows first child if forked.
cmd_top() {
  ensure_gs_init
  local cur
  cur="$(current_branch)"

  while true; do
    local children=()
    while IFS= read -r c; do
      [[ -n "$c" ]] && children+=("$c")
    done <<< "$(get_children "$cur")"

    if [[ ${#children[@]} -eq 0 ]]; then
      break
    elif [[ ${#children[@]} -eq 1 ]]; then
      cur="${children[0]}"
    else
      # Multiple children — pick the first one (follow the leftmost path)
      echo "Multiple children at '$cur', following first: ${children[0]}"
      cur="${children[0]}"
    fi
  done

  git checkout "$cur" --quiet
  success "switched to '$cur' (top of stack)"
}

# Jump to the bottommost branch (first branch above trunk).
cmd_bottom() {
  ensure_gs_init
  local cur
  cur="$(current_branch)"
  local trunk
  trunk="$(trunk_branch)"

  while true; do
    local parent
    parent="$(get_parent "$cur" 2>/dev/null)" || break
    if [[ "$parent" == "$trunk" ]]; then
      break
    fi
    cur="$parent"
  done

  if [[ "$cur" == "$(current_branch)" ]] && [[ "$(get_parent "$cur" 2>/dev/null)" != "$trunk" ]]; then
    die "current branch is not part of a tracked stack"
  fi

  git checkout "$cur" --quiet
  success "switched to '$cur' (bottom of stack)"
}

# Reparent the current branch onto a different target. Rebases and restacks upstack.
cmd_move() {
  ensure_gs_init
  local target=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --onto) shift; target="${1:-}"; [[ -z "$target" ]] && die "--onto requires a branch" ;;
      *) die "usage: gs move --onto <target>" ;;
    esac
    shift
  done

  [[ -z "$target" ]] && die "usage: gs move --onto <target>"
  branch_exists "$target" || die "branch '$target' does not exist"

  local cur
  cur="$(current_branch)"
  is_tracked "$cur" || die "'$cur' is not tracked by gs"

  local old_parent
  old_parent="$(get_parent "$cur")"

  # Rebase current branch onto target
  info "rebasing '$cur' onto '$target'..."
  git rebase --onto "$target" "$old_parent" "$cur" --quiet || {
    die "rebase failed — resolve conflicts, then update metadata manually"
  }

  # Update metadata
  set_parent "$cur" "$target"

  # Restack upstack
  info "restacking upstack branches..."
  restack_upstack "$cur"

  success "moved '$cur' onto '$target'"
}

# Remove a branch from gs tracking without deleting the git branch.
# Children get reparented to this branch's parent.
cmd_untrack() {
  ensure_gs_init
  local branch="${1:-$(current_branch)}"

  is_tracked "$branch" || die "'$branch' is not tracked by gs"

  local parent
  parent="$(get_parent "$branch")"

  # Reparent children to this branch's parent
  local children
  children="$(get_children "$branch")"
  for child in $children; do
    set_parent "$child" "$parent"
    info "reparented '$child' to '$parent'"
  done

  remove_tracking "$branch"
  success "untracked '$branch' (git branch still exists)"
}

# Squash-merge current branch into its parent, delete it, reparent children, restack.
cmd_fold() {
  ensure_gs_init
  local cur
  cur="$(current_branch)"

  is_tracked "$cur" || die "'$cur' is not tracked by gs"

  local parent
  parent="$(get_parent "$cur")"
  local trunk
  trunk="$(trunk_branch)"

  [[ "$parent" == "$trunk" ]] && [[ "$cur" == "$trunk" ]] && die "cannot fold trunk"

  # Reparent children to the parent
  local children
  children="$(get_children "$cur")"
  for child in $children; do
    set_parent "$child" "$parent"
    info "reparented '$child' to '$parent'"
  done

  # Switch to parent and merge current branch
  git checkout "$parent" --quiet
  info "merging '$cur' into '$parent'..."
  git merge --squash "$cur" --quiet
  git commit --no-edit --quiet 2>/dev/null || {
    warn "staged merge changes — commit them manually on '$parent'"
  }

  # Delete the branch and its tracking
  git branch -D "$cur" --quiet 2>/dev/null
  remove_tracking "$cur"

  # Restack children
  restack_upstack "$parent"

  success "folded '$cur' into '$parent'"
}

# Push from current branch down through the stack to trunk (force-with-lease).
# Pushes bottom-up so remote branch dependencies are satisfied in order.
cmd_push() {
  ensure_gs_init
  local cur
  cur="$(current_branch)"
  local trunk
  trunk="$(trunk_branch)"

  # Build the downstack path from current branch to trunk
  local stack=()
  local b="$cur"
  while [[ "$b" != "$trunk" ]]; do
    stack+=("$b")
    local p
    p="$(get_parent "$b" 2>/dev/null)" || break
    b="$p"
  done

  # Push from bottom to top (reverse)
  local len=${#stack[@]}
  for ((i = len - 1; i >= 0; i--)); do
    local branch="${stack[$i]}"
    info "pushing '$branch'..."
    git push -u origin "$branch" --force-with-lease 2>&1 | sed "s/^/  /"
  done

  success "pushed $len branch(es)"
}

# Push downstack and create/update draft PRs for each branch.
# Each PR targets its parent branch in the stack.
cmd_push_pr() {
  ensure_gs_init
  local cur
  cur="$(current_branch)"
  local trunk
  trunk="$(trunk_branch)"

  # Build the downstack path
  local stack=()
  local b="$cur"
  while [[ "$b" != "$trunk" ]]; do
    stack+=("$b")
    local p
    p="$(get_parent "$b" 2>/dev/null)" || break
    b="$p"
  done

  # Push first
  local len=${#stack[@]}
  for ((i = len - 1; i >= 0; i--)); do
    local branch="${stack[$i]}"
    info "pushing '$branch'..."
    git push -u origin "$branch" --force-with-lease 2>&1 | sed "s/^/  /"
  done

  success "pushed $len branch(es)"
  echo ""

  _create_stack_prs "${stack[@]}"
}

# Helper: create/update draft PRs for a list of branches (bottom-up order expected).
_create_stack_prs() {
  local branches=("$@")
  local len=${#branches[@]}

  for ((i = len - 1; i >= 0; i--)); do
    local branch="${branches[$i]}"
    local parent
    parent="$(get_parent "$branch" 2>/dev/null)" || continue

    # Check if PR already exists
    local existing_url
    existing_url="$(gh pr view "$branch" --json url --jq '.url' 2>/dev/null)" || existing_url=""

    if [[ -n "$existing_url" ]]; then
      info "PR exists for '$branch': $existing_url"
      # Update the base branch in case it changed
      gh pr edit "$branch" --base "$parent" 2>/dev/null || true
    else
      # Generate title from branch name: slashes/hyphens -> spaces, title case
      local title
      title="$(echo "$branch" | sed 's|[-/]| |g' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) tolower(substr($i,2))}1')"

      info "creating draft PR for '$branch' -> '$parent'..."
      local pr_url
      pr_url="$(gh pr create \
        --head "$branch" \
        --base "$parent" \
        --title "$title" \
        --body "Part of a stack. Created by gs." \
        --draft 2>&1)" || {
        warn "failed to create PR for '$branch'"
        continue
      }
      success "  $pr_url"
    fi
  done
}

# Check whether a branch has been merged. Uses `gh pr view` first (handles
# squash-merge, which leaves no shared commits), then falls back to git cherry.
branch_is_merged() {
  local branch="$1"
  if command -v gh &>/dev/null; then
    local state
    state="$(gh pr view "$branch" --json state --jq '.state' 2>/dev/null)" || state=""
    case "$state" in
      MERGED) return 0 ;;
      OPEN|DRAFT) return 1 ;;
    esac
  fi
  # Fallback: check whether all of the branch's commits are reachable from trunk.
  local trunk
  trunk="$(trunk_branch)"
  local unmerged
  unmerged="$(git cherry "$trunk" "$branch" 2>/dev/null | grep -c '^+' || true)"
  [[ "$unmerged" == "0" ]]
}

# Collect all tracked descendants of a branch in BFS order (parent before child).
collect_descendants_bfs() {
  local root="$1"
  local queue=("$root")
  local out=()
  while [[ ${#queue[@]} -gt 0 ]]; do
    local head="${queue[0]}"
    queue=("${queue[@]:1}")
    while IFS= read -r child; do
      [[ -n "$child" ]] || continue
      out+=("$child")
      queue+=("$child")
    done <<< "$(get_children "$head")"
  done
  printf '%s\n' "${out[@]}"
}

# Pull trunk, drop merged branches, and restack the rest onto trunk.
cmd_sync() {
  ensure_gs_init
  local trunk
  trunk="$(trunk_branch)"
  local original
  original="$(current_branch)"

  info "fetching from origin..."
  git fetch origin --prune --quiet

  info "updating trunk '$trunk'..."
  git checkout "$trunk" --quiet
  git pull --ff-only --quiet || die "could not fast-forward '$trunk'. Resolve manually and retry."

  # Walk all tracked branches in BFS order from trunk.
  local all_branches=()
  while IFS= read -r b; do
    [[ -n "$b" ]] && all_branches+=("$b")
  done <<< "$(collect_descendants_bfs "$trunk")"

  if [[ ${#all_branches[@]} -eq 0 ]]; then
    success "no tracked branches; nothing to sync"
    return 0
  fi

  info "checking ${#all_branches[@]} tracked branch(es) for merged PRs..."

  # Detect merged branches. Process in BFS order so when we reparent a merged
  # branch's children to its parent, the parent has already been resolved if it
  # was also merged (its children were lifted to its grandparent earlier).
  local merged=()
  for branch in "${all_branches[@]}"; do
    branch_exists "$branch" || continue
    if branch_is_merged "$branch"; then
      info "  '$branch' is merged"
      merged+=("$branch")
    fi
  done

  if [[ ${#merged[@]} -eq 0 ]]; then
    info "no merged branches to clean up"
  else
    # Snapshot all merged branch tips before any rebasing or deletion.
    # After squash-merge, the squashed commit in trunk has new SHAs — the
    # merged branch's tip is the correct fork point for its children so
    # only the children's own commits get rebased.
    local tips_dir
    tips_dir="$(gs_dir)/old_tips"
    mkdir -p "$tips_dir"
    for branch in "${merged[@]}"; do
      branch_exists "$branch" || continue
      local tip
      tip="$(git rev-parse "$branch" 2>/dev/null)" || tip=""
      if [[ -n "$tip" ]]; then
        echo "$tip" > "$tips_dir/sync_merged_$(encode_branch "$branch")"
      fi
    done

    for branch in "${merged[@]}"; do
      local parent
      parent="$(get_parent "$branch" 2>/dev/null)" || parent="$trunk"

      local merged_tip
      merged_tip="$(cat "$tips_dir/sync_merged_$(encode_branch "$branch")" 2>/dev/null)" || merged_tip=""

      # Reparent children and rebase them past the merged branch's commits.
      local children
      children="$(get_children "$branch")"
      for child in $children; do
        set_parent "$child" "$parent"
        info "reparented '$child' onto '$parent'"

        if [[ -n "$merged_tip" ]] && branch_exists "$child"; then
          if git rebase --onto "$parent" "$merged_tip" "$child" --quiet 2>/dev/null; then
            info "  rebased '$child' past merged commits"
          else
            warn "conflict rebasing '$child' onto '$parent' — resolve manually, then run 'gs restack --all'"
          fi
        fi
      done

      remove_tracking "$branch"
      if branch_exists "$branch"; then
        git branch -D "$branch" --quiet 2>/dev/null || warn "could not delete branch '$branch'"
      fi
      success "deleted merged branch '$branch'"
    done
  fi

  # Restack what's left. Direct children of merged branches were already
  # rebased above (skipping the merged commits), so restack_upstack will
  # see them as up-to-date and only recurse into deeper descendants.
  info "restacking remaining branches onto '$trunk'..."
  restack_upstack "$trunk"
  cleanup_restack_tips

  if branch_exists "$original"; then
    git checkout "$original" --quiet
  else
    info "original branch '$original' was deleted; staying on '$trunk'"
  fi

  success "sync complete"
}

# Delete a branch from both git and gs tracking. Reparents children to parent.
cmd_delete() {
  ensure_gs_init
  local branch="${1:-$(current_branch)}"
  local trunk
  trunk="$(trunk_branch)"

  [[ "$branch" == "$trunk" ]] && die "cannot delete trunk branch"

  local cur
  cur="$(current_branch)"

  if is_tracked "$branch"; then
    local parent
    parent="$(get_parent "$branch")"

    # Reparent children
    local children
    children="$(get_children "$branch")"
    for child in $children; do
      set_parent "$child" "$parent"
      info "reparented '$child' to '$parent'"
    done

    remove_tracking "$branch"

    # If we're on the branch being deleted, move to parent
    if [[ "$cur" == "$branch" ]]; then
      git checkout "$parent" --quiet
    fi
  else
    if [[ "$cur" == "$branch" ]]; then
      git checkout "$trunk" --quiet
    fi
  fi

  git branch -D "$branch" 2>/dev/null
  success "deleted branch '$branch'"
}

# Diff current branch against its parent (default) or a specified branch.
cmd_diff() {
  ensure_gs_init
  local target=""

  if [[ -n "${1:-}" ]]; then
    target="$1"
    branch_exists "$target" || die "branch '$target' does not exist"
  else
    local cur
    cur="$(current_branch)"
    target="$(get_parent "$cur" 2>/dev/null)" || die "'$cur' has no tracked parent — pass a branch name explicitly"
  fi

  git diff "$target"...HEAD
}

# Rename the current branch (or a specified branch) to a new name.
cmd_rename() {
  ensure_gs_init
  local new_name="${1:-}"
  [[ -z "$new_name" ]] && die "usage: gs rename <new-name>"

  local cur
  cur="$(current_branch)"
  local trunk
  trunk="$(trunk_branch)"
  [[ "$cur" == "$trunk" ]] && die "cannot rename trunk branch"

  # Rename the git branch
  git branch -m "$cur" "$new_name"

  # Update gs tracking: transfer parent to new name
  if is_tracked "$cur"; then
    local parent
    parent="$(get_parent "$cur")"
    set_parent "$new_name" "$parent"
    remove_tracking "$cur"
  fi

  # Reparent any children that pointed to the old name
  local children
  children="$(get_children "$cur")"
  for child in $children; do
    set_parent "$child" "$new_name"
  done

  success "renamed '$cur' to '$new_name'"
}

# Open the PR for the current branch in the browser.
cmd_pr() {
  ensure_git_repo
  gh pr view --web 2>/dev/null || die "no PR found for '$(current_branch)'"
}

# Passthrough to git checkout. Keeps gs as a single entry point for branch work.
cmd_checkout() {
  ensure_git_repo
  git checkout "$@"
}

cmd_help() {
  cat <<'HELP'
gs (git-stack) — stacked branch workflow

Usage: gs <command> [options]

Commands:
  init                    Initialize gs in current repo
  create <name> [-m msg]  Create a new stacked branch
  track <b1> [b2] ...     Track existing branches as a stack
  stack <branch>          Add a branch on top of the current one
  commit [-a] [-m msg]    Commit and auto-restack upstack
  restack [--all]         Rebase upstack branches (or entire stack)
  ls / list               Show the stack tree
  log                     Show stack tree with commit messages
  up [N]                  Move up to child branch
  down [N]                Move down to parent branch
  top                     Jump to topmost branch in stack
  bottom                  Jump to bottommost branch (near trunk)
  move --onto <branch>    Move current branch to a new parent
  untrack [branch]        Remove branch from gs tracking
  fold                    Merge current branch into its parent
  push                    Push downstack branches to remote
  push-pr                 Push downstack and create/update draft PRs
  pr                      Open the PR for current branch in browser
  checkout / co            Passthrough to git checkout
  diff [branch]           Diff against parent branch (or specified branch)
  delete [branch]         Delete branch from stack and git
  sync                    Pull trunk, drop merged branches, restack the rest
  help                    Show this help message
HELP
}

# ── Main dispatch ───────────────────────────────────────────────────────────

main() {
  local cmd="${1:-help}"
  shift 2>/dev/null || true

  case "$cmd" in
    init)     cmd_init "$@" ;;
    create)   cmd_create "$@" ;;
    track)    cmd_track "$@" ;;
    stack)    cmd_stack "$@" ;;
    commit)   cmd_commit "$@" ;;
    restack)  cmd_restack "$@" ;;
    ls|list)  cmd_ls "$@" ;;
    log)      cmd_log "$@" ;;
    up)       cmd_up "$@" ;;
    down)     cmd_down "$@" ;;
    top)      cmd_top "$@" ;;
    bottom)   cmd_bottom "$@" ;;
    move)     cmd_move "$@" ;;
    untrack)  cmd_untrack "$@" ;;
    fold)     cmd_fold "$@" ;;
    push)     cmd_push "$@" ;;
    push-pr)  cmd_push_pr "$@" ;;
    pr)       cmd_pr "$@" ;;
    checkout|co) cmd_checkout "$@" ;;
    diff)     cmd_diff "$@" ;;
    delete)   cmd_delete "$@" ;;
    sync)     cmd_sync "$@" ;;
    help|-h|--help) cmd_help ;;
    *)        die "unknown command: $cmd. Run 'gs help' for usage." ;;
  esac
}

main "$@"
