#!/usr/bin/env bash

# gs (git-stack) — stacked branch workflow tool
#
# Inspired by Graphite (graphite.dev) which provides a stacked PR workflow.
# Key difference: Graphite treats each branch as a single commit that gets
# amended via `gt modify`. We don't like that — branches here can have
# multiple commits, and `gs commit` simply adds a new commit then rebases
# all upstack (child) branches to propagate the change.
#
# Metadata lives in .git/gs/ — a config file for trunk and a branches/
# directory where each file maps a branch to its parent. That's it.
# Branch names with slashes are URL-encoded (%2F) for safe filesystem use.
#
# Core workflow:
#   gs init                 → set up tracking in a repo
#   gs create <name>        → new branch stacked on current
#   gs commit -m "msg"      → commit + auto-restack upstack branches
#   gs track b1 b2 b3       → retroactively stack existing branches
#   gs ls / gs log           → visualize the stack
#   gs up / gs down          → navigate the stack
#   gs restack               → manual rebase propagation (for when you
#                              use raw git commands instead of gs commit)
#
# This file is meant to grow over time. Keep commands as functions (cmd_*)
# and add new ones to the dispatch table in main() at the bottom.

set -eo pipefail

# ── Colors ──────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

# ── Helpers ─────────────────────────────────────────────────────────────────

die() {
  printf "${RED}error:${RESET} %s\n" "$*" >&2
  exit 1
}

info() {
  printf "${CYAN}%s${RESET}\n" "$*"
}

warn() {
  printf "${YELLOW}warning:${RESET} %s\n" "$*" >&2
}

success() {
  printf "${GREEN}%s${RESET}\n" "$*"
}

ensure_git_repo() {
  [[ -n "${GS_COMMON_DIR:-}" ]] || die "not a git repository"
}

# main resolves this once. Every git process costs 5-25 ms here, and the
# metadata helpers below used to re-run rev-parse on each call (16 times for
# one `gs ls`). All linked worktrees share one common dir, so it stays valid
# even when gs runs git in another worktree of the same repo.
git_common_dir() {
  printf '%s\n' "$GS_COMMON_DIR"
}

# Reads the first line of a file without starting `cat`. Fails when the file
# is missing, like `cat` did.
read_first_line() {
  local line=""
  [[ -f "$1" ]] || return 1
  IFS= read -r line < "$1" || true
  printf '%s\n' "$line"
}

atomic_write() {
  local target="$1" value="$2" tmp
  [[ -d "${target%/*}" ]] || mkdir -p "${target%/*}"
  tmp="${target}.tmp.$$"
  printf '%s\n' "$value" > "$tmp"
  mv "$tmp" "$target"
}

metadata_dirs_match() {
  diff -qr "$1" "$2" >/dev/null 2>&1
}

# Older gs versions used --git-dir, which placed metadata in each linked
# worktree's private git directory. Move one consistent legacy copy into the
# common git directory. Conflicting copies need a human decision.
migrate_legacy_metadata() {
  # Separate declarations: bash 3.2 does not see a local assigned earlier in
  # the same `local` statement.
  local common="$1"
  local shared="$common/gs" legacy_dirs=() candidate d

  if [[ -d "$common/worktrees" ]]; then
    for d in "$common"/worktrees/*/gs; do
      [[ -d "$d" ]] && legacy_dirs+=("$d")
    done
  fi

  [[ ${#legacy_dirs[@]} -gt 0 ]] || return 0

  if [[ -d "$shared" ]]; then
    candidate="$shared"
  else
    candidate="${legacy_dirs[0]}"
  fi

  for d in "${legacy_dirs[@]}"; do
    metadata_dirs_match "$candidate" "$d" ||
      die "conflicting gs metadata found at '$candidate' and '$d'. Reconcile these directories before running gs."
    [[ ! -e "${d}.migrated" ]] || die "cannot preserve legacy metadata because '${d}.migrated' already exists"
  done

  if [[ ! -d "$shared" ]]; then
    local shared_tmp="${shared}.tmp.$$"
    cp -R "${legacy_dirs[0]}" "$shared_tmp"
    mv "$shared_tmp" "$shared"
  fi

  for d in "${legacy_dirs[@]}"; do
    [[ -d "$d" ]] || continue
    mv "$d" "${d}.migrated"
  done

  warn "migrated legacy worktree-local gs metadata to '$shared'"
}

gs_dir() {
  migrate_legacy_metadata "$GS_COMMON_DIR"
  printf '%s\n' "$GS_COMMON_DIR/gs"
}

ensure_gs_init() {
  ensure_git_repo
  local d
  d="$(gs_dir)"
  [[ -d "$d" ]] || die "gs is not initialized in this repo. Run 'gs init' first."
}

current_branch() {
  git symbolic-ref --short HEAD 2>/dev/null || die "HEAD is detached"
}

trunk_branch() {
  read_first_line "$(gs_dir)/config" || die "cannot read trunk config"
}

branch_exists() {
  git show-ref --verify --quiet "refs/heads/$1" 2>/dev/null
}

# Encode branch name for safe filesystem use (/ -> %2F). Bash expansion
# instead of sed: this runs once per branch file on every listing.
encode_branch() {
  local s="${1//\%/%25}"
  printf '%s\n' "${s//\//%2F}"
}

# Decode branch name from filesystem (%2F -> /)
decode_branch() {
  local s="${1//%2F//}"
  printf '%s\n' "${s//%25/%}"
}

is_tracked() {
  [[ -f "$(gs_dir)/branches/$(encode_branch "$1")" ]]
}

get_parent() {
  read_first_line "$(gs_dir)/branches/$(encode_branch "$1")"
}

set_parent() {
  # $1 = branch, $2 = parent
  atomic_write "$(gs_dir)/branches/$(encode_branch "$1")" "$2"
}

track_branch() {
  local branch="$1" parent="$2" base
  branch_exists "$branch" && branch_exists "$parent" || die "cannot track missing branch '$branch' or parent '$parent'"
  base="$(git merge-base "$branch" "$parent" 2>/dev/null)" ||
    die "branches '$branch' and '$parent' do not share history"
  set_parent "$branch" "$parent"
  set_base_oid "$branch" "$base"
}

remove_tracking() {
  rm -f "$(gs_dir)/branches/$(encode_branch "$1")"
  rm -f "$(gs_dir)/bases/$(encode_branch "$1")"
}

get_base_oid() {
  read_first_line "$(gs_dir)/bases/$(encode_branch "$1")"
}

set_base_oid() {
  atomic_write "$(gs_dir)/bases/$(encode_branch "$1")" "$2"
}

# Return all tracked children of a branch
get_children() {
  local parent="$1" dir f value
  dir="$(gs_dir)/branches"
  [[ -d "$dir" ]] || return 0
  for f in "$dir"/*; do
    [[ -f "$f" ]] || continue
    value=""
    IFS= read -r value < "$f" || [[ -n "$value" ]] || continue
    [[ "$value" == "$parent" ]] && decode_branch "${f##*/}"
  done
  return 0
}

# Check if $1 is in the list of subsequent args
is_in_list() {
  local needle="$1"
  shift
  for item in "$@"; do
    [[ "$item" == "$needle" ]] && return 0
  done
  return 1
}

# Count commits on a branch relative to its parent
count_commits() {
  local branch="$1"
  local parent
  parent="$(get_parent "$branch" 2>/dev/null)" || return 0
  git rev-list --count "$parent".."$branch" 2>/dev/null || echo 0
}

# ── Commands ────────────────────────────────────────────────────────────────

# Set up gs in a repo. Creates .git/gs/ dir and records which branch is trunk.
cmd_init() {
  ensure_git_repo
  local d
  d="$(gs_dir)"

  if [[ -d "$d" ]]; then
    warn "gs is already initialized in this repo"
    info "trunk: $(trunk_branch)"
    return 0
  fi

  local trunk=""
  # Check for explicit argument
  if [[ ${1:-} == "--trunk" ]] && [[ -n ${2:-} ]]; then
    trunk="$2"
  else
    # Auto-detect
    for candidate in main master; do
      if branch_exists "$candidate"; then
        trunk="$candidate"
        break
      fi
    done
  fi

  if [[ -z "$trunk" ]]; then
    die "could not detect trunk branch. Use: gs init --trunk <branch>"
  fi

  mkdir -p "$d/branches" "$d/bases"
  atomic_write "$d/config" "$trunk"
  success "initialized gs with trunk branch '$trunk'"
}

# Build a cache dir with PR status and dirty state for all tracked branches.
# Returns the cache directory path via stdout.
build_ls_cache() {
  local include_pr="${1:-0}"
  local cache_dir
  cache_dir="$(gs_dir)/ls_cache"
  rm -rf "$cache_dir" 2>/dev/null
  mkdir -p "$cache_dir"

  local trunk
  trunk="$(trunk_branch)"

  # PR status: query gh once per branch. Skipped unless --pr was passed,
  # since each gh call adds noticeable latency.
  if [[ "$include_pr" == "1" ]] && command -v gh &>/dev/null; then
    local all_branches=()
    while IFS= read -r b; do
      [[ -n "$b" ]] && all_branches+=("$b")
    done <<< "$(collect_descendants_bfs "$trunk")"
    for b in "${all_branches[@]}"; do
      local state
      state="$(gh pr view "$b" --json state --jq '.state' 2>/dev/null)" || state=""
      [[ -n "$state" ]] && echo "$state" > "$cache_dir/pr_$(encode_branch "$b")"
    done
  fi

  # Dirty state: map worktree paths → branch names, then check git status.
  local wt_path="" wt_branch=""
  while IFS= read -r line; do
    if [[ "$line" == "worktree "* ]]; then
      wt_path="${line#worktree }"
      wt_branch=""
    elif [[ "$line" == "branch "* ]]; then
      wt_branch="${line#branch }"
    elif [[ -z "$line" && -n "$wt_path" ]]; then
      # The porcelain listing already names each worktree's branch, so no
      # extra rev-parse per worktree. Detached worktrees have no branch line.
      local br="${wt_branch#refs/heads/}"
      if [[ -n "$br" ]] && [[ -n "$(git -C "$wt_path" status --porcelain 2>/dev/null)" ]]; then
        touch "$cache_dir/dirty_$(encode_branch "$br")"
      fi
      wt_path=""
      wt_branch=""
    fi
  done < <(git worktree list --porcelain)

  echo "$cache_dir"
}

# Show the stack as a tree with branch names, commit counts, PR status, and dirty state.
cmd_ls() {
  ensure_gs_init
  local include_pr=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --pr) include_pr=1 ;;
      *) die "unknown argument: $1" ;;
    esac
    shift
  done
  local trunk cur cache_dir
  trunk="$(trunk_branch)"
  cur="$(current_branch)"
  cache_dir="$(build_ls_cache "$include_pr")"

  echo -e "${BOLD}${YELLOW}$trunk${RESET}"
  print_tree "$trunk" "" "$cur" "$cache_dir"
}

# Recursive tree printer
# $1 = parent branch, $2 = prefix for indentation, $3 = current branch, $4 = cache dir
print_tree() {
  local parent="$1"
  local prefix="$2"
  local cur="$3"
  local cache_dir="$4"

  local children=()
  while IFS= read -r c; do
    [[ -n "$c" ]] && children+=("$c")
  done <<< "$(get_children "$parent")"

  local count=${#children[@]}
  local i=0

  for child in "${children[@]}"; do
    i=$((i + 1))
    local connector="├── "
    local child_prefix="${prefix}│   "
    if [[ $i -eq $count ]]; then
      connector="└── "
      child_prefix="${prefix}    "
    fi

    local commits
    commits="$(count_commits "$child")"

    # PR status indicator
    local pr=""
    local pr_file="$cache_dir/pr_$(encode_branch "$child")"
    if [[ -f "$pr_file" ]]; then
      case "$(read_first_line "$pr_file")" in
        OPEN)   pr=" ${GREEN}[open]${RESET}" ;;
        MERGED) pr=" ${MAGENTA}[merged]${RESET}" ;;
        CLOSED) pr=" ${RED}[closed]${RESET}" ;;
      esac
    fi

    # Dirty indicator
    local dirty=""
    local dirty_file="$cache_dir/dirty_$(encode_branch "$child")"
    [[ -f "$dirty_file" ]] && dirty=" ${YELLOW}*${RESET}"

    local marker=""
    if [[ "$child" == "$cur" ]]; then
      marker=" ${GREEN}← you are here${RESET}"
    fi

    local color="${YELLOW}"
    if [[ "$child" == "$cur" ]]; then
      color="${GREEN}${BOLD}"
    fi

    echo -e "${prefix}${connector}${color}${child}${RESET}${pr}${dirty} ${DIM}(${commits} commit$([ "$commits" != "1" ] && echo "s"))${RESET}${marker}"
    print_tree "$child" "$child_prefix" "$cur" "$cache_dir"
  done
}

# Show the stack tree with individual commit hashes, messages, PR status, and dirty state.
cmd_log() {
  ensure_gs_init
  local include_pr=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --pr) include_pr=1 ;;
      *) die "unknown argument: $1" ;;
    esac
    shift
  done
  local trunk cur cache_dir
  trunk="$(trunk_branch)"
  cur="$(current_branch)"
  cache_dir="$(build_ls_cache "$include_pr")"

  echo -e "${BOLD}${YELLOW}$trunk${RESET}"
  print_log_tree "$trunk" "" "$cur" "$cache_dir"
}

print_log_tree() {
  local parent="$1"
  local prefix="$2"
  local cur="$3"
  local cache_dir="$4"

  local children=()
  while IFS= read -r c; do
    [[ -n "$c" ]] && children+=("$c")
  done <<< "$(get_children "$parent")"

  local count=${#children[@]}
  local i=0

  for child in "${children[@]}"; do
    i=$((i + 1))
    local connector="├── "
    local child_prefix="${prefix}│   "
    if [[ $i -eq $count ]]; then
      connector="└── "
      child_prefix="${prefix}    "
    fi

    # PR status indicator
    local pr=""
    local pr_file="$cache_dir/pr_$(encode_branch "$child")"
    if [[ -f "$pr_file" ]]; then
      case "$(read_first_line "$pr_file")" in
        OPEN)   pr=" ${GREEN}[open]${RESET}" ;;
        MERGED) pr=" ${MAGENTA}[merged]${RESET}" ;;
        CLOSED) pr=" ${RED}[closed]${RESET}" ;;
      esac
    fi

    # Dirty indicator
    local dirty=""
    local dirty_file="$cache_dir/dirty_$(encode_branch "$child")"
    [[ -f "$dirty_file" ]] && dirty=" ${YELLOW}*${RESET}"

    local marker=""
    if [[ "$child" == "$cur" ]]; then
      marker=" ${GREEN}← you are here${RESET}"
    fi

    local color="${YELLOW}"
    if [[ "$child" == "$cur" ]]; then
      color="${GREEN}${BOLD}"
    fi

    echo -e "${prefix}${connector}${color}${child}${RESET}${pr}${dirty}${marker}"

    # Show commits on this branch
    local parent_branch
    parent_branch="$(get_parent "$child" 2>/dev/null)" || parent_branch="$parent"
    local commits
    commits="$(git log --oneline "$parent_branch".."$child" 2>/dev/null)" || commits=""
    if [[ -n "$commits" ]]; then
      while IFS= read -r line; do
        local hash msg
        hash="${line%% *}"
        msg="${line#* }"
        echo -e "${child_prefix}$msg ${DIM}${BLUE}$hash${RESET}"
      done <<< "$commits"
    fi

    print_log_tree "$child" "$child_prefix" "$cur" "$cache_dir"
  done
}

# Navigate up (toward children). Prompts if multiple children exist.
cmd_up() {
  ensure_gs_init
  local steps="${1:-1}"
  local cur
  cur="$(current_branch)"

  for ((s = 0; s < steps; s++)); do
    local children=()
    while IFS= read -r c; do
      [[ -n "$c" ]] && children+=("$c")
    done <<< "$(get_children "$cur")"

    if [[ ${#children[@]} -eq 0 ]]; then
      die "no child branches above '$(current_branch)'"
    elif [[ ${#children[@]} -eq 1 ]]; then
      cur="${children[0]}"
    else
      echo "Multiple children of '$(current_branch)':"
      local idx=1
      for c in "${children[@]}"; do
        echo "  $idx) $c"
        idx=$((idx + 1))
      done
      printf "Pick [1-%d]: " "${#children[@]}"
      read -r choice
      choice=$((choice - 1))
      if [[ $choice -lt 0 ]] || [[ $choice -ge ${#children[@]} ]]; then
        die "invalid choice"
      fi
      cur="${children[$choice]}"
    fi
  done

  checkout_navigation_target "$cur"
  success "switched to '$cur'"
}

# Navigate down (toward parent/trunk).
cmd_down() {
  ensure_gs_init
  local steps="${1:-1}"
  local cur
  cur="$(current_branch)"

  for ((s = 0; s < steps; s++)); do
    local parent
    parent="$(get_parent "$cur" 2>/dev/null)" || die "'$cur' has no tracked parent"
    cur="$parent"
  done

  checkout_navigation_target "$cur"
  success "switched to '$cur'"
}

# Jump to the topmost branch in the current stack path. Follows first child if forked.
cmd_top() {
  ensure_gs_init
  local cur
  cur="$(current_branch)"

  while true; do
    local children=()
    while IFS= read -r c; do
      [[ -n "$c" ]] && children+=("$c")
    done <<< "$(get_children "$cur")"

    if [[ ${#children[@]} -eq 0 ]]; then
      break
    elif [[ ${#children[@]} -eq 1 ]]; then
      cur="${children[0]}"
    else
      # Multiple children — pick the first one (follow the leftmost path)
      echo "Multiple children at '$cur', following first: ${children[0]}"
      cur="${children[0]}"
    fi
  done

  checkout_navigation_target "$cur"
  success "switched to '$cur' (top of stack)"
}

# Jump to the bottommost branch (first branch above trunk).
cmd_bottom() {
  ensure_gs_init
  local cur
  cur="$(current_branch)"
  local trunk
  trunk="$(trunk_branch)"

  while true; do
    local parent
    parent="$(get_parent "$cur" 2>/dev/null)" || break
    if [[ "$parent" == "$trunk" ]]; then
      break
    fi
    cur="$parent"
  done

  if [[ "$cur" == "$(current_branch)" ]] && [[ "$(get_parent "$cur" 2>/dev/null)" != "$trunk" ]]; then
    die "current branch is not part of a tracked stack"
  fi

  checkout_navigation_target "$cur"
  success "switched to '$cur' (bottom of stack)"
}

# Push from current branch down through the stack to trunk (force-with-lease).
# Pushes bottom-up so remote branch dependencies are satisfied in order.
cmd_push() {
  ensure_gs_init
  local push_all=0
  local extra_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all) push_all=1 ;;
      *) extra_args+=("$1") ;;
    esac
    shift
  done

  local trunk
  trunk="$(trunk_branch)"

  local stack=()
  if [[ $push_all -eq 1 ]]; then
    # Every tracked branch, BFS from trunk so parents push before children.
    while IFS= read -r b; do
      [[ -n "$b" ]] && branch_exists "$b" && stack+=("$b")
    done <<< "$(collect_descendants_bfs "$trunk")"
  else
    # Downstack path from current branch to trunk, bottom-first.
    local cur
    cur="$(current_branch)"
    local path=()
    local b="$cur"
    while [[ "$b" != "$trunk" ]]; do
      path+=("$b")
      local p
      p="$(get_parent "$b" 2>/dev/null)" || break
      b="$p"
    done
    local plen=${#path[@]}
    for ((i = plen - 1; i >= 0; i--)); do
      stack+=("${path[$i]}")
    done
  fi

  local len=${#stack[@]}
  [[ $len -eq 0 ]] && die "nothing to push"

  for branch in "${stack[@]}"; do
    info "pushing '$branch'..."
    git push -u origin "$branch" --force-with-lease "${extra_args[@]}" 2>&1 | sed "s/^/  /"
  done

  success "pushed $len branch(es)"
}

# Push downstack and create/update draft PRs for each branch.
# Each PR targets its parent branch in the stack.
cmd_push_pr() {
  ensure_gs_init
  local cur
  cur="$(current_branch)"
  local trunk
  trunk="$(trunk_branch)"

  # Build the downstack path
  local stack=()
  local b="$cur"
  while [[ "$b" != "$trunk" ]]; do
    stack+=("$b")
    local p
    p="$(get_parent "$b" 2>/dev/null)" || break
    b="$p"
  done

  # Push first
  local len=${#stack[@]}
  for ((i = len - 1; i >= 0; i--)); do
    local branch="${stack[$i]}"
    info "pushing '$branch'..."
    git push -u origin "$branch" --force-with-lease 2>&1 | sed "s/^/  /"
  done

  success "pushed $len branch(es)"
  echo ""

  _create_stack_prs "${stack[@]}"
}

# Helper: create/update draft PRs for a list of branches (bottom-up order expected).
_create_stack_prs() {
  local branches=("$@")
  local len=${#branches[@]}

  for ((i = len - 1; i >= 0; i--)); do
    local branch="${branches[$i]}"
    local parent
    parent="$(get_parent "$branch" 2>/dev/null)" || continue

    # Check if PR already exists
    local existing_url
    existing_url="$(gh pr view "$branch" --json url --jq '.url' 2>/dev/null)" || existing_url=""

    if [[ -n "$existing_url" ]]; then
      info "PR exists for '$branch': $existing_url"
      # Update the base branch in case it changed
      gh pr edit "$branch" --base "$parent" 2>/dev/null || true
    else
      # Use the first commit message on the branch as the PR title.
      local title
      title="$(git log --format=%s --reverse "$parent".."$branch" 2>/dev/null | head -1)"
      [[ -z "$title" ]] && title="$branch"

      info "creating draft PR for '$branch' -> '$parent'..."
      local pr_url
      pr_url="$(gh pr create \
        --head "$branch" \
        --base "$parent" \
        --title "$title" \
        --body "Part of a stack. Created by gs." \
        --draft 2>&1)" || {
        warn "failed to create PR for '$branch'"
        continue
      }
      success "  $pr_url"
    fi
  done
}

# Check whether a branch has been merged. Uses `gh pr view` first (handles
# squash-merge, which leaves no shared commits), then falls back to git cherry.
branch_is_merged() {
  local branch="$1"
  if command -v gh &>/dev/null; then
    local state
    state="$(gh pr view "$branch" --json state --jq '.state' 2>/dev/null)" || state=""
    case "$state" in
      MERGED) return 0 ;;
      OPEN|DRAFT) return 1 ;;
    esac
  fi
  # Fallback: check whether all of the branch's commits are reachable from trunk.
  local trunk
  trunk="$(trunk_branch)"
  local unmerged
  unmerged="$(git cherry "$trunk" "$branch" 2>/dev/null | grep -c '^+' || true)"
  [[ "$unmerged" == "0" ]]
}

# Collect all tracked descendants of a branch in BFS order (parent before child).
collect_descendants_bfs() {
  local root="$1"
  local queue=("$root")
  local out=()
  while [[ ${#queue[@]} -gt 0 ]]; do
    local head="${queue[0]}"
    queue=("${queue[@]:1}")
    while IFS= read -r child; do
      [[ -n "$child" ]] || continue
      out+=("$child")
      queue+=("$child")
    done <<< "$(get_children "$head")"
  done
  printf '%s\n' "${out[@]}"
}

# Find the bottommost branch in the stack path leading to the given branch.
find_bottom() {
  local cur="$1"
  local trunk
  trunk="$(trunk_branch)"

  while true; do
    local parent
    parent="$(get_parent "$cur" 2>/dev/null)" || break
    [[ "$parent" == "$trunk" ]] && break
    cur="$parent"
  done
  echo "$cur"
}

# Diff current branch against its parent (default) or a specified branch.
cmd_diff() {
  ensure_gs_init
  local target=""

  if [[ -n "${1:-}" ]]; then
    target="$1"
    branch_exists "$target" || die "branch '$target' does not exist"
  else
    local cur
    cur="$(current_branch)"
    target="$(get_parent "$cur" 2>/dev/null)" || die "'$cur' has no tracked parent — pass a branch name explicitly"
  fi

  git diff "$target"...HEAD
}

# Open the PR for the current branch in the browser.
cmd_pr() {
  ensure_git_repo
  gh pr view --web 2>/dev/null || die "no PR found for '$(current_branch)'"
}

# Passthrough to git checkout. Keeps gs as a single entry point for branch work.
cmd_checkout() {
  ensure_git_repo
  git checkout "$@"
}

cmd_help() {
  cat <<'HELP'
gs (git-stack) — stacked branch workflow

Usage: gs <command> [options]

Commands:
  init                    Initialize gs in current repo
  create <name> [-m msg]  Create a new stacked branch
  rename <new-name>       Rename current branch and update gs metadata
  track <b1> [b2] ...     Track existing branches as a stack
  stack <branch>          Add a branch on top of the current one
  commit [-a] [-m msg]    Commit and auto-restack upstack
  restack [--all] [--autostash] [--continue|--abort]
                          Rebase upstack branches (or entire stack)
  status                  Show the active shared gs operation
  ls / list [--pr]        Show the stack tree (--pr fetches PR status)
  log [--pr]              Show stack tree with commit messages (--pr fetches PR status)
  up [N]                  Move up to child branch
  down [N]                Move down to parent branch
  top                     Jump to topmost branch in stack
  bottom                  Jump to bottommost branch (near trunk)
  move --onto <branch>    Move current branch to a new parent
  insert <name> --between <parent> <child>
                          Splice a new branch between an existing parent and child
  untrack [branch]        Remove branch from gs tracking
  fold                    Merge current branch into its parent
  split <commit> <name>   Split branch at commit, rest becomes new child
  land [branch]           Merge the bottommost PR into trunk and clean up
  push [--all]            Push downstack branches to remote (--all = every tracked branch)
  push-pr                 Push downstack and create/update draft PRs
  pr                      Open the PR for current branch in browser
  checkout / co            Passthrough to git checkout
  diff [branch]           Diff against parent branch (or specified branch)
  delete [branch]         Delete branch from stack and git
  sync [--all]            Pull trunk, drop merged branches, restack current stack (--all = every stack)
  help                    Show this help message
HELP
}

# ── Main dispatch ───────────────────────────────────────────────────────────

# The worktree-aware commands live in gs-worktree.sh.
GS_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=gs-worktree.sh
source "$GS_SCRIPT_DIR/gs-worktree.sh"

main() {
  local cmd="${1:-help}"
  shift 2>/dev/null || true

  # Global --dry-run / -n flag (before the command)
  if [[ "$cmd" == "--dry-run" || "$cmd" == "-n" ]]; then
    export GS_DRY_RUN=1
    cmd="${1:-help}"
    shift 2>/dev/null || true
  fi

  # Empty outside a git repo. ensure_git_repo reports that per command, so
  # `gs help` still works anywhere.
  GS_COMMON_DIR="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"

  guard_command_against_active_operation "$cmd" "${1:-}"
  acquire_mutation_lock "$cmd"

  case "$cmd" in
    init)     cmd_init "$@" ;;
    create)   cmd_create "$@" ;;
    track)    cmd_track "$@" ;;
    stack)    cmd_stack "$@" ;;
    commit)   cmd_commit "$@" ;;
    restack)  cmd_restack "$@" ;;
    status)   cmd_status "$@" ;;
    ls|list)  cmd_ls "$@" ;;
    log)      cmd_log "$@" ;;
    up)       cmd_up "$@" ;;
    down)     cmd_down "$@" ;;
    top)      cmd_top "$@" ;;
    bottom)   cmd_bottom "$@" ;;
    move)     cmd_move "$@" ;;
    insert)   cmd_insert "$@" ;;
    untrack)  cmd_untrack "$@" ;;
    fold)     cmd_fold "$@" ;;
    split)    cmd_split "$@" ;;
    land)     cmd_land "$@" ;;
    push)     cmd_push "$@" ;;
    push-pr)  cmd_push_pr "$@" ;;
    pr)       cmd_pr "$@" ;;
    checkout|co) cmd_checkout "$@" ;;
    diff)     cmd_diff "$@" ;;
    delete)   cmd_delete "$@" ;;
    rename)   cmd_rename "$@" ;;
    sync)     cmd_sync "$@" ;;
    help|-h|--help) cmd_help ;;
    *)        die "unknown command: $cmd. Run 'gs help' for usage." ;;
  esac
}

main "$@"
