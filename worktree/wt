# wt — git worktree manager
#
# Creates worktrees in a configured base directory, hard-links a configurable
# set of ignored files/directories (CLAUDE.md, CLAUDE.local.md, .claude, .env*, …)
# from the main worktree,
# then cds in the new one.
#
# Configuration is via env vars; both can be set in your shell rc:
#   WT_WORKTREES_DIR  base directory for all worktrees (run `wt install <path>`
#                     once and it'll write the export into ~/.zshrc for you)
#   WT_LINK_IGNORED   space-separated globs, relative to the main worktree,
#                     that get hard-linked into each new worktree
#                     (default: "CLAUDE.md CLAUDE.local.md .claude .env* .rtk")

: "${WT_WORKTREES_DIR:=__NOT_CONFIGURED__}"
: "${WT_LINK_IGNORED:=CLAUDE.md CLAUDE.local.md .claude .env* .rtk}"

# ─────────────────────────────────────────────────────────────────────────────
# Worktree discovery
#
# `wt` used to derive a worktree's display name by stripping the
# "$WT_WORKTREES_DIR/<repo>/" prefix off its path. That only works for
# worktrees `wt` created itself. Codex (and other agent harnesses) create
# worktrees at paths like
#     $WT_WORKTREES_DIR/codex/<4-hex>/<repo-name>
# i.e. the repo name is the LAST component and a meaningless session id sits in
# the middle. Under the old prefix-strip the label came out as the entire
# absolute path, so `wt switch` listed unreadable garbage and substring
# matching effectively never hit. Worse, Codex often leaves the worktree on a
# detached HEAD, so there is no branch name to fall back on either.
#
# So discovery is centralised here: one scanner that labels every worktree,
# whoever created it, and tags where it came from.
# ─────────────────────────────────────────────────────────────────────────────

_wt_main_worktree() {
  git worktree list --porcelain 2>/dev/null | awk '/^worktree / { print $2; exit }'
}

# Map Codex-created worktree paths to their human thread names.
#
# Codex names worktree dirs after an opaque 4-hex session prefix and very often
# leaves them on a detached HEAD, so `wt list` would otherwise show a column of
# "detached@45e5405 / codex 9747" rows that are impossible to tell apart. But
# Codex does know what each session was about: every rollout JSONL opens with a
# session_meta line carrying both `cwd` and `session_id`, and
# ~/.codex/session_index.jsonl maps session_id -> the thread name shown in the
# app ("Fix Token Limit"). Joining those two gives each worktree a real title.
#
# Emits "<worktree-path> <TAB> <thread name>". Best-effort: silent no-op when
# rg or the Codex dirs are missing.
_wt_codex_titles() {
  local codex_home="${CODEX_HOME:-$HOME/.codex}"
  local index="$codex_home/session_index.jsonl"
  [[ -f "$index" ]] || return 0
  command -v rg &>/dev/null || return 0

  local -a session_dirs=()
  [[ -d "$codex_home/sessions" ]] && session_dirs+=("$codex_home/sessions")
  [[ -d "$codex_home/archived_sessions" ]] && session_dirs+=("$codex_home/archived_sessions")
  [[ ${#session_dirs[@]} -eq 0 ]] && return 0

  # `-m1` stops at the session_meta line (always line 1), which is what keeps
  # this fast despite the sessions dir being ~1GB: rg never reads past the head
  # of each file. Measured at ~15ms over 570 rollouts.
  rg --no-messages -o --no-filename --no-line-number -m1 \
     '"session_id":"[^"]*".*?"cwd":"[^"]*/worktrees/codex/[^"]*"' \
     "${session_dirs[@]}" 2>/dev/null \
  | awk -v index_file="$index" '
      {
        if (match($0, /"session_id":"[^"]*"/)) {
          sid = substr($0, RSTART + 14, RLENGTH - 15)
        } else next
        if (match($0, /"cwd":"[^"]*"/)) {
          cwd = substr($0, RSTART + 7, RLENGTH - 8)
        } else next
        # A worktree dir gets reused across sessions, so several rollouts can
        # claim the same cwd; the newest one is the session the user actually
        # has open there. Compare the meta line s ISO-8601 timestamp explicitly
        # rather than trusting input order — rg searches files in parallel, so
        # "last line wins" would make the label flicker between runs.
        stamp = ""
        if (match($0, /"timestamp":"[^"]*"/)) {
          stamp = substr($0, RSTART + 13, RLENGTH - 14)
        }
        if (stamp >= newest[cwd]) { newest[cwd] = stamp; sid_for[cwd] = sid }
      }
      END {
        while ((getline line < index_file) > 0) {
          if (match(line, /"id":"[^"]*"/)) {
            id = substr(line, RSTART + 6, RLENGTH - 7)
          } else continue
          if (match(line, /"thread_name":"[^"]*"/)) {
            title[id] = substr(line, RSTART + 15, RLENGTH - 16)
          }
        }
        for (cwd in sid_for) {
          name = title[sid_for[cwd]]
          if (name != "") printf "%s\t%s\n", cwd, name
        }
      }'
}

# Base dir for THIS repo's managed worktrees: $WT_WORKTREES_DIR/<repo-name>.
_wt_dir() {
  local main_wt="${1:-$(_wt_main_worktree)}"
  [[ -z "$main_wt" || "$WT_WORKTREES_DIR" == "__NOT_CONFIGURED__" ]] && return 1
  local repo_name="${main_wt:t}"
  # Resolve symlinks when the dir already exists so path comparisons against
  # `git worktree list` output (which is always resolved) actually match. The
  # subshell is load-bearing: a bare `cd` here would move the *caller's* shell
  # out of the repo, and every later git command would fail.
  ( cd "$WT_WORKTREES_DIR/$repo_name" 2>/dev/null && pwd -P ) || echo "$WT_WORKTREES_DIR/$repo_name"
}

# Emit one tab-separated record per LINKED worktree (main and bare excluded):
#     label <TAB> branch <TAB> origin <TAB> path
#
#   label  — what the user sees and types: the managed relative name, else the
#            branch name, else "detached@<short-sha>".
#   branch — branch name, or "" when detached.
#   origin — "wt" (managed, lives under $WT_WORKTREES_DIR/<repo>/) or
#            "codex:<id>" / "ext" for anything created outside wt.
_wt_scan() {
  local main_wt="$(_wt_main_worktree)"
  [[ -z "$main_wt" ]] && return 1
  local wtdir="$(_wt_dir "$main_wt")"
  local base="${WT_WORKTREES_DIR:A}"

  # Codex thread titles, looked up once per scan rather than per worktree.
  local -A codex_title=()
  local title_line
  while IFS= read -r title_line; do
    [[ -z "$title_line" ]] && continue
    codex_title[${title_line%%	*}]="${title_line#*	}"
  done < <(_wt_codex_titles)

  local wt_path="" wt_branch="" wt_head="" wt_bare=0
  # `local path=...` would be a bug here, not a style nit: in zsh `path` is
  # tied to `PATH`, so declaring it local blanks out the command search path
  # for the rest of the function and every external command (git included)
  # silently stops resolving. Hence the wt_ prefixes.
  # `git worktree list --porcelain` emits a blank-line-separated stanza per
  # worktree; flush on the blank line (and once more at EOF, since the final
  # stanza's trailing newline is eaten by the while-read).
  _wt_scan_flush() {
    [[ -z "$wt_path" || $wt_bare -eq 1 || "$wt_path" == "$main_wt" ]] && {
      wt_path=""; wt_branch=""; wt_head=""; wt_bare=0; return
    }
    local label="" origin="ext"
    if [[ -n "$wtdir" && "$wt_path" == "$wtdir/"* ]]; then
      label="${wt_path#$wtdir/}"
      origin="wt"
    else
      # Codex layout: $WT_WORKTREES_DIR/codex/<id>/<repo>. Pull the <id> out so
      # two worktrees on the same branch (or two detached ones) stay tellable
      # apart, and so the user can type the id itself to jump.
      local rest="${wt_path#$base/}"
      if [[ "$rest" != "$wt_path" && "$rest" == codex/* ]]; then
        local id="${${rest#codex/}%%/*}"
        origin="codex:$id"
      fi
      # Prefer the Codex thread title — "Fix Token Limit" is what the user
      # actually remembers, far more than a branch name or a short sha.
      label="${codex_title[$wt_path]:-${wt_branch:-detached@${wt_head[1,7]}}}"
    fi
    print -r -- "$label	$wt_branch	$origin	$wt_path"
    wt_path=""; wt_branch=""; wt_head=""; wt_bare=0
  }

  local line
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) wt_path="${line#worktree }" ;;
      "HEAD "*)     wt_head="${line#HEAD }" ;;
      "branch "*)   wt_branch="${${line#branch }#refs/heads/}" ;;
      "bare")       wt_bare=1 ;;
      "")           _wt_scan_flush ;;
    esac
  done < <(git worktree list --porcelain 2>/dev/null)
  _wt_scan_flush
  unfunction _wt_scan_flush
}

# Turn a scan record's origin field into a display tag.
_wt_origin_tag() {
  case "$1" in
    codex:*) print -r -- "codex ${1#codex:}" ;;
    ext)     print -r -- "external" ;;
    *)       print -r -- "" ;;
  esac
}

# Render a numbered, column-headed table from scan records passed on stdin.
#
# Design notes, both driven by the table being hard to read in practice:
#
#  1. There ARE headers. Without them the columns are guesswork — a bare
#     "codex 26fe" or a lone "*" tells you nothing about what it means.
#  2. No cell is ever left blank. The earlier version suppressed the branch
#     when it equalled the label — true for every wt-created worktree — so most
#     rows rendered as a name followed by a stretch of whitespace, and the table
#     looked half-empty and broken. An empty cell reads as missing data. But
#     repeating the branch verbatim is pure noise when it's identical to the
#     name, so identical branches collapse to a "-" placeholder: visibly
#     "same as NAME", not "unknown".
#
# Column widths are measured from the rows actually being shown (including the
# headers), rather than hardcoded: fixed widths looked fine in one repo and bad
# in the next, stranding the status column far to the right on short names and
# breaking alignment when one long branch overflowed.
#
# A column is dropped entirely when every row (and so the whole column) is
# empty — e.g. SOURCE in a repo with no agent-created worktrees — so we don't
# print a header for a column with nothing under it.
#
# There is deliberately no dirty/uncommitted column: it cost a `git diff` per
# worktree on every `wt list`, and `wt list` is for finding a worktree, not for
# auditing its state. Check that in the worktree itself.
_wt_render() {
  local -a records=("${(@f)$(cat)}")
  [[ ${#records[@]} -eq 1 && -z "${records[1]}" ]] && return 0

  local -a names=() branches=() sources=()
  local rec
  for rec in "${records[@]}"; do
    [[ -z "$rec" ]] && continue
    local -a f=("${(@s:	:)rec}")
    names+=("${f[1]}")
    # "-" means "same as NAME"; "(detached)" means genuinely no branch.
    if [[ -z "${f[2]}" ]]; then
      branches+=("(detached)")
    elif [[ "${f[2]}" == "${f[1]}" ]]; then
      branches+=("-")
    else
      branches+=("${f[2]}")
    fi
    sources+=("$(_wt_origin_tag "${f[3]}")")
  done

  local count=${#names[@]}
  (( count == 0 )) && return 0

  # Measure each column across its header and all its values; width 0 marks a
  # column that is entirely empty and therefore gets dropped.
  local -a headers=(NAME BRANCH SOURCE)
  local -a widths=(0 0 0)
  local col idx val
  for col in 1 2 3; do
    local -a column
    case $col in
      1) column=("${names[@]}") ;;
      2) column=("${branches[@]}") ;;
      3) column=("${sources[@]}") ;;
    esac
    local widest=0
    for val in "${column[@]}"; do (( ${#val} > widest )) && widest=${#val}; done
    (( widest > 0 )) && (( ${#headers[$col]} > widest )) && widest=${#headers[$col]}
    widths[$col]=$widest
  done

  # `line` is declared once, outside the loops: re-running `local` on an
  # already-declared local makes zsh *print* the variable (typeset's display
  # behaviour), which leaks "line=..." noise into the output.
  local line

  # Header, indented to clear the "NNN) " gutter the value rows use (printf
  # '%3d) ' is five characters wide).
  line="     "
  for col in 1 2 3; do
    (( widths[col] == 0 )) && continue
    line+="$(printf '%-*s  ' "${widths[$col]}" "${headers[$col]}")"
  done
  print -r -- "${line%"${line##*[! ]}"}"

  for (( idx = 1; idx <= count; idx++ )); do
    line="$(printf '%3d) ' "$idx")"
    for col in 1 2 3; do
      (( widths[col] == 0 )) && continue
      case $col in
        1) val="${names[$idx]}" ;;
        2) val="${branches[$idx]}" ;;
        3) val="${sources[$idx]}" ;;
      esac
      line+="$(printf '%-*s  ' "${widths[$col]}" "$val")"
    done
    # Strip trailing padding without needing extendedglob: ${line##*[! ]} is
    # the trailing run of spaces, and %"..." removes exactly that suffix.
    print -r -- "${line%"${line##*[! ]}"}"
  done
}

wt() {
  if [[ -z "$1" || "$1" == "--help" || "$1" == "-h" ]]; then
    echo "wt — git worktree manager"
    echo ""
    echo "Usage: wt create <name> [base-branch]  Create a worktree and open Claude"
    echo "       wt create                   Prompt for name (and base branch)"
    echo "       wt list                     List worktrees, numbered"
    echo "       wt switch [name|number]     Switch to a worktree (fuzzy match)"
    echo "       wt main                     Jump back to the main worktree"
	    echo "       wt rename <old> <new>       Rename a worktree and its branch"
    echo "       wt clean [name] [--force]   Remove a worktree and its branch (defaults to current)"
	    echo "       wt clean --merged           Remove all worktrees with merged branches"
    echo "       wt push [remote-branch]     Push to remote (defaults to same branch name)"
    echo "       wt install <path>           Set the base directory for worktrees"
    if [[ "$WT_WORKTREES_DIR" == "__NOT_CONFIGURED__" ]]; then
      echo ""
      echo "⚠ Not configured yet. Run: wt install <path>"
    else
      echo ""
      echo "Worktrees dir: $WT_WORKTREES_DIR"
    fi
    return 0
  fi

  if [[ "$1" == "c" || "$1" == "create" ]]; then
    local name="${2:-}"
    local base="${3:-$(git rev-parse --abbrev-ref HEAD)}"
    local use_remote=0
    [[ "$3" == "--remote" || "$4" == "--remote" ]] && use_remote=1
    # No name given → prompt instead of erroring out. `wt create` on its own is
    # the natural thing to type when you know you want a worktree but haven't
    # settled on the branch name yet; making that a usage error just forces a
    # retype. Empty input aborts.
    if [[ -z "$name" ]]; then
      echo -n "Worktree/branch name: "
      read -r name
      [[ -z "$name" ]] && echo "wt create: aborted (no name given)" && return 1
      local base_default="$base"
      echo -n "Base branch [$base_default]: "
      read -r base
      [[ -z "$base" ]] && base="$base_default"
    fi
  elif [[ "$1" == "install" ]]; then
    local new_path="${2:-}"
    [[ -z "$new_path" ]] && echo "Usage: wt install <path>" && return 1

    # Expand to absolute path
    new_path="${new_path:A}"
    mkdir -p "$new_path" || { echo "Failed to create directory: $new_path"; return 1; }

    # Persist as an export in ~/.zshrc — update in place if already there,
    # otherwise append.
    local rc="$HOME/.zshrc"
    if [[ -f "$rc" ]] && grep -q "^export WT_WORKTREES_DIR=" "$rc"; then
      sed -i '' "s|^export WT_WORKTREES_DIR=.*|export WT_WORKTREES_DIR=\"$new_path\"|" "$rc"
    else
      echo "export WT_WORKTREES_DIR=\"$new_path\"" >> "$rc"
    fi
    export WT_WORKTREES_DIR="$new_path"

    # Install zsh completion for wt.
    local comp_dir="$HOME/.zsh/completions"
    mkdir -p "$comp_dir"
    local comp_src="${functions_source[wt]:A:h}/_wt"
    if [[ -f "$comp_src" ]]; then
      cp "$comp_src" "$comp_dir/_wt"
      if ! grep -q '$HOME/.zsh/completions' "$rc" 2>/dev/null; then
        echo 'fpath=($HOME/.zsh/completions $fpath)' >> "$rc"
        echo 'autoload -Uz compinit && compinit' >> "$rc"
      fi
      echo "Installed wt completion to $comp_dir/_wt"
    else
      echo "Note: _wt completion file not found at $comp_src — skipping"
    fi

    echo "Worktrees directory set to: $new_path"
    echo "Saved as: export WT_WORKTREES_DIR in $rc"
    return 0
  fi

  if [[ "$1" == "push" ]]; then
    local branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
    local remote_branch="${2:-$branch}"
    git push -u origin "$branch:$remote_branch" --force-with-lease
    return $?
  fi

  if [[ "$WT_WORKTREES_DIR" == "__NOT_CONFIGURED__" ]]; then
    echo "wt is not configured yet. Run: wt install <path>"
    return 1
  fi

  local main_worktree="$(git worktree list --porcelain | awk '/^worktree / { print $2; exit }')"
  local repo_name="$(basename "$main_worktree")"
  local worktrees_dir
  worktrees_dir="$(cd "$WT_WORKTREES_DIR/$repo_name" 2>/dev/null && pwd -P || echo "$WT_WORKTREES_DIR/$repo_name")"

  # Getting *out* of an agent-created worktree was previously a manual `cd` to
  # a path you had to remember; switch only ever moved between linked ones.
  if [[ "$1" == "main" ]]; then
    cd "$main_worktree" || return 1
    return 0
  fi

  if [[ "$1" == "list" ]]; then
    # `wt list` used to be a bare passthrough to `git worktree list`, which is
    # unusable once agent harnesses are in play: 20 near-identical absolute
    # paths, half of them detached. Show the same numbered rows `wt switch`
    # uses instead, so what you read is what you can type.
    local -a rows=("${(@f)$(_wt_scan)}")
    if [[ ${#rows[@]} -eq 0 || -z "${rows[1]}" ]]; then
      echo "No linked worktrees. Main: $main_worktree"
      return 0
    fi
    echo "$main_worktree  (main)"
    local table
    table="$(printf '%s\n' "${rows[@]}" | _wt_render)"
    print -r -- "$table"
    echo ""
    # Only explain the notation actually on screen — _wt_render drops columns
    # that are entirely empty, and a legend for an absent column is just noise.
    # Match a "-" standing alone as a whole cell, not a hyphen inside a branch
    # name like durable-exec/branch2-subagent.
    if print -r -- "$table" | grep -qE '( -$| - +)'; then
      echo "  BRANCH '-' = same as NAME."
    fi
    echo "  Jump with: wt switch <number|name|branch|codex-id>"
    return 0
  fi

  if [[ "$1" == "switch" ]]; then
    local name="${2:-}"

    local -a records=("${(@f)$(_wt_scan)}")
    [[ ${#records[@]} -eq 1 && -z "${records[1]}" ]] && records=()
    if [[ ${#records[@]} -eq 0 ]]; then
      echo "wt switch: no linked worktrees found"
      return 1
    fi

    # A bare number selects straight out of the last `wt list` / picker
    # ordering — the fastest path when you've just looked at the list.
    if [[ "$name" =~ '^[0-9]+$' ]] && (( name >= 1 && name <= ${#records[@]} )); then
      local -a f=("${(@s:	:)records[$name]}")
      cd "${f[4]}" || return 1
      return 0
    fi

    local -a matches=()
    local rec
    if [[ -n "$name" ]]; then
      # Match against label, branch, and the codex session id, so any of
      # `wt switch guardrails`, `wt switch AI-1557`, `wt switch 2d54` land.
      for rec in "${records[@]}"; do
        local -a f=("${(@s:	:)rec}")
        if [[ "${f[1]}" == *"$name"* || "${f[2]}" == *"$name"* || "${f[3]}" == *"$name"* ]]; then
          matches+=("$rec")
        fi
      done
      if [[ ${#matches[@]} -eq 0 ]]; then
        echo "wt switch: no worktree matching '$name'"
        return 1
      elif [[ ${#matches[@]} -eq 1 ]]; then
        local -a f=("${(@s:	:)matches[1]}")
        cd "${f[4]}" || return 1
        return 0
      fi
    else
      matches=("${records[@]}")
    fi

    # Interactive picker for multiple matches (or no filter).
    local selected_path=""
    if command -v fzf &>/dev/null; then
      # Render "<display>\t<path>" into fzf, hide the path column, and read the
      # path back off the selected line — no re-matching on the display text.
      local line
      line="$(
        for rec in "${matches[@]}"; do
          local -a f=("${(@s:	:)rec}")
          local extra="${f[2]:-detached}"
          [[ "${f[1]}" == "$extra" ]] && extra=""
          local origin_tag=""
          [[ "${f[3]}" == codex:* ]] && origin_tag="codex ${f[3]#codex:}"
          [[ "${f[3]}" == ext ]] && origin_tag="external"
          printf '%-34s %-28s %s\t%s\n' "${f[1]}" "$extra" "$origin_tag" "${f[4]}"
        done | fzf --prompt="worktree> " --with-nth=1 --delimiter=$'\t' \
                   --preview 'git -C {2} log --oneline -8 2>/dev/null; echo; git -C {2} status --short 2>/dev/null | head -10' \
                   --preview-window=right:50%:wrap
      )"
      [[ -n "$line" ]] && selected_path="${line##*$'\t'}"
    else
      echo "Select a worktree:"
      printf '%s\n' "${matches[@]}" | _wt_render
      echo -n "> "
      read -r selected_num
      if [[ "$selected_num" =~ ^[0-9]+$ ]] && (( selected_num >= 1 && selected_num <= ${#matches[@]} )); then
        local -a f=("${(@s:	:)matches[$selected_num]}")
        selected_path="${f[4]}"
      fi
    fi

    if [[ -n "$selected_path" ]]; then
      cd "$selected_path" || return 1
    fi
    return 0
  fi

  # Migrate Claude Code session JSONLs from a worktree's project dir into the
  # main worktree's project dir, rewriting embedded path references so threads
  # look like they were always rooted in the main worktree.
  _wt_migrate_threads() {
    local wt_path="$1" main_path="$2"
    local proj_root="$HOME/.claude/projects"
    local wt_proj="$proj_root/${wt_path//\//-}"
    local main_proj="$proj_root/${main_path//\//-}"
    [[ ! -d "$wt_proj" ]] && return 0
    mkdir -p "$main_proj"
    local migrated=0 file
    local d=$'\x01'
    for file in "$wt_proj"/*.jsonl(N); do
      local tmp="$file.tmp"
      # Use a delimiter unlikely to appear in absolute paths.
      if sed "s${d}${wt_path}${d}${main_path}${d}g" "$file" > "$tmp"; then
        mv "$tmp" "$main_proj/$(basename "$file")"
        rm -f "$file"
        migrated=$((migrated + 1))
      else
        rm -f "$tmp"
      fi
    done
    rmdir "$wt_proj" 2>/dev/null
    [[ $migrated -gt 0 ]] && echo "Migrated $migrated Claude thread(s) to main worktree."
  }

  if [[ "$1" == "clean" ]]; then
    local force=0
    local name=""
    local merged_only=0

    # Parse args: --force, --merged, and optional name can appear in any order
    for arg in "${@:2}"; do
      if [[ "$arg" == "--force" ]]; then
        force=1
      elif [[ "$arg" == "--merged" ]]; then
        merged_only=1
      else
        name="$arg"
      fi
    done

    local main_repo="$(git worktree list --porcelain | awk '/^worktree / { if (NR==1) print $2 }')"

    # --merged: clean all worktrees whose branches are merged
    if [[ $merged_only -eq 1 ]]; then
      if [[ -n "$name" ]]; then
        echo "wt clean: --merged does not take a name argument"
        return 1
      fi
      local wt_path="" wt_bare=0 wt_name="" cleaned=0
      while IFS= read -r line; do
        if [[ "$line" == "worktree "* ]]; then
          wt_path="${line#worktree }"
          wt_bare=0
        elif [[ "$line" == "bare" ]]; then
          wt_bare=1
        elif [[ -z "$line" ]]; then
          if [[ "$wt_bare" != "1" && "$wt_path" != "$main_repo" ]]; then
            wt_name="${wt_path#$worktrees_dir/}"
            local merged=0
            if command -v gh &>/dev/null; then
              local state
              state="$(gh pr view "$wt_name" --json state --jq '.state' 2>/dev/null)" || state=""
              [[ "$state" == "MERGED" ]] && merged=1
            fi
            if [[ $merged -eq 0 ]]; then
              git -C "$main_repo" branch --merged HEAD 2>/dev/null | grep -q "$wt_name" && merged=1
            fi
            if [[ $merged -eq 1 ]]; then
              [[ "$(pwd)" == "$wt_path" ]] && cd "$main_repo"
              _wt_migrate_threads "$wt_path" "$main_repo"
              git worktree remove "$wt_path" --force 2>/dev/null
              git branch -D "$wt_name" 2>/dev/null
              echo "Cleaned up merged worktree '$wt_name'."
              cleaned=$((cleaned + 1))
            fi
          fi
          wt_path=""
          wt_bare=0
        fi
      done < <(git worktree list --porcelain)
      [[ $cleaned -eq 0 ]] && echo "No merged worktrees to clean."
      return 0
    fi

    if [[ -n "$name" ]]; then
      # Resolve through the scanner rather than assuming
      # "$worktrees_dir/$name": that assumption is what made `wt clean` unable
      # to touch Codex worktrees, whose paths don't follow wt's layout. Match
      # on label/branch/codex-id, exactly like `wt switch`.
      local worktree_path="" branch="" rec
      local -a hits=()
      while IFS= read -r rec; do
        [[ -z "$rec" ]] && continue
        local -a f=("${(@s:	:)rec}")
        [[ "${f[1]}" == *"$name"* || "${f[2]}" == *"$name"* || "${f[3]}" == *"$name"* ]] && hits+=("$rec")
      done < <(_wt_scan)
      if [[ ${#hits[@]} -eq 0 ]]; then
        echo "wt clean: no worktree matching '$name'"
        return 1
      elif [[ ${#hits[@]} -gt 1 ]]; then
        echo "wt clean: '$name' matches ${#hits[@]} worktrees — be more specific:"
        printf '%s\n' "${hits[@]}" | _wt_render
        return 1
      fi
      local -a f=("${(@s:	:)hits[1]}")
      worktree_path="${f[4]}"
      branch="${f[2]}"
    else
      local worktree_path="$(pwd)"
      local branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
      if [[ "$worktree_path" == "$main_repo" ]]; then
        echo "wt clean: you're in the main worktree, not a linked one. Aborting."
        return 1
      fi
    fi

    if [[ $force -eq 0 ]]; then
      local uncommitted="$(git -C "$worktree_path" status --porcelain)"
      if [[ -n "$uncommitted" ]]; then
        echo "Uncommitted changes in $worktree_path:"
        git -C "$worktree_path" status --short
        echo "\nRun 'wt clean $name --force' to delete anyway."
        return 1
      fi
    fi

    [[ "$(pwd)" == "$worktree_path" ]] && cd "$main_repo"
    _wt_migrate_threads "$worktree_path" "$main_repo"
    git worktree remove "$worktree_path" --force
    # Codex worktrees are frequently on a detached HEAD, so there may be no
    # branch to delete — `git branch -D ""` would just error out.
    if [[ -n "$branch" ]]; then
      git branch -D "$branch"
      echo "Cleaned up worktree '$branch'."
    else
      echo "Cleaned up detached worktree at $worktree_path."
    fi
    return 0
  fi

  if [[ "$1" == "rename" ]]; then
    local old_name="${2:-}"
    local new_name="${3:-}"
    [[ -z "$old_name" || -z "$new_name" ]] && echo "Usage: wt rename <old-name> <new-name>" && return 1

    local old_path="$worktrees_dir/$old_name"
    [[ ! -d "$old_path" ]] && echo "wt rename: no worktree found at $old_path" && return 1

    local new_path="$worktrees_dir/$new_name"
    [[ -d "$new_path" ]] && echo "wt rename: target '$new_name' already exists" && return 1

    git -C "$old_path" branch -M "$old_name" "$new_name" 2>/dev/null || {
      echo "wt rename: failed to rename branch '$old_name' to '$new_name'"
      return 1
    }

    # Use git worktree move if available (Git 2.17+), otherwise fall back to mv.
    if git worktree move "$old_path" "$new_path" 2>/dev/null; then
      :
    else
      mv "$old_path" "$new_path"
    fi
    [[ "$(pwd)" == "$old_path" ]] && cd "$new_path"
    echo "Renamed worktree '$old_name' -> '$new_name'."
    return 0
  fi

  if [[ "$1" != "create" && "$1" != "c" ]]; then
    local name="$1"
    local base="${2:-$(git rev-parse --abbrev-ref HEAD)}"
  fi

  local root="$main_worktree"
  if git rev-parse --verify "refs/heads/$name" &>/dev/null; then
    git worktree add "$worktrees_dir/$name" "$name" || return 1
  elif [[ $use_remote -eq 1 ]] && git fetch origin "$name" &>/dev/null && git rev-parse --verify "refs/remotes/origin/$name" &>/dev/null; then
    git worktree add "$worktrees_dir/$name" --track -b "$name" "origin/$name" || return 1
  else
    git worktree add "$worktrees_dir/$name" -b "$name" "$base" || return 1
  fi
  cd "$worktrees_dir/$name" || return 1
  _wt_link_ignored "$root" .
}

# Hard-link (files) or symlink (directories) each WT_LINK_IGNORED glob from the
# main worktree $root into the worktree $dest.
#
# Files are hard-linked so they behave like real files to tools that don't
# follow symlinks; directories are symlinked because macOS can't hard-link a
# directory. Globs are matched against the main worktree.
#
# This is `find`-based rather than a zsh `**/` glob, and that is the whole
# point. The glob version hung for ~13 SECONDS PER PATTERN on a large repo
# (devops-monorepo: 6.8 GB, 38k directories) — five patterns, so over a minute
# of apparent hang after `wt create` had already printed its git output and
# cd'ed in, which reads exactly like a lockup.
#
# The old code carried a comment claiming its `(^e:...:)` qualifier "excludes"
# .git and node_modules so they aren't walked. That was wrong: a glob qualifier
# FILTERS MATCHES AFTER THE WALK. zsh still descended into every directory,
# then discarded results. `find ... -prune` genuinely stops descending, which is
# what makes it ~50x faster here (38,599 dirs walked -> 5,782).
#
# The prune list also matters more than the old exclusions suggested: in
# devops-monorepo, `.venv` accounts for 36,480 of those 38,599 directories and
# wasn't excluded at all, while node_modules — which was — doesn't exist. Prune
# heavy dependency/build/cache trees; none of them hold the dotfiles we link.
_wt_link_ignored() {
  local root="$1" dest="$2"
  local -a prune_names=(
    .git node_modules .venv venv target dist build
    __pycache__ .mypy_cache .pytest_cache .ruff_cache .cpcache .tox
    .next .gradle .terraform .cache
  )

  # Assemble `-name X -o -name Y ...` for the prune branch.
  local -a prune_expr=()
  local prune_name
  for prune_name in "${prune_names[@]}"; do
    (( ${#prune_expr[@]} )) && prune_expr+=(-o)
    prune_expr+=(-name "$prune_name")
  done

  local pattern match rel
  for pattern in ${=WT_LINK_IGNORED}; do
    # -print0/read -d '' so paths with spaces survive. The pattern is matched
    # against the basename, mirroring the old glob's `**/<pattern>` semantics:
    # a nested `apps/foo/.env` is linked at the same relative path.
    while IFS= read -r -d '' match; do
      rel="${match#$root/}"
      [[ "$rel" == "$match" ]] && continue
      # Never descend into a directory we just symlinked: a linked `.claude`
      # would otherwise be re-found through its own symlink and produce
      # `.claude/.claude`. -P keeps find from following links in $root, but the
      # destination side needs its own guard for repeat runs.
      [[ -L "$dest/${rel%%/*}" ]] && continue
      mkdir -p "$dest/${rel:h}"
      if [[ -d "$match" ]]; then
        ln -sfn "$match" "$dest/$rel"
      else
        ln -f "$match" "$dest/$rel"
      fi
    done < <(find -P "$root" \( "${prune_expr[@]}" \) -prune -o -name "$pattern" -print0 2>/dev/null)
  done
}
