# wt — git worktree manager
#
# Creates worktrees in a configured base directory, hard-links a configurable
# set of ignored files (CLAUDE.local.md, .env*, …) from the main worktree,
# then cds in the new one.
#
# Configuration is via env vars; both can be set in your shell rc:
#   WT_WORKTREES_DIR  base directory for all worktrees (run `wt install <path>`
#                     once and it'll write the export into ~/.zshrc for you)
#   WT_LINK_IGNORED   space-separated globs, relative to the main worktree,
#                     that get hard-linked into each new worktree
#                     (default: "CLAUDE.local.md .env*")

: "${WT_WORKTREES_DIR:=__NOT_CONFIGURED__}"
: "${WT_LINK_IGNORED:=CLAUDE.local.md .env*}"

wt() {
  if [[ -z "$1" ]]; then
    echo "wt — git worktree manager"
    echo ""
    echo "Usage: wt create <name> [base-branch]  Create a worktree and open Claude"
    echo "       wt list                     List all worktrees"
    echo "       wt switch <name>            Switch to a worktree by branch name"
    echo "       wt clean [name] [--force]   Remove a worktree and its branch (defaults to current)"
    echo "       wt push [remote-branch]     Push to remote (defaults to same branch name)"
    echo "       wt install <path>           Set the base directory for worktrees"
    if [[ "$WT_WORKTREES_DIR" == "__NOT_CONFIGURED__" ]]; then
      echo ""
      echo "⚠ Not configured yet. Run: wt install <path>"
    else
      echo ""
      echo "Worktrees dir: $WT_WORKTREES_DIR"
    fi
    return 0
  fi

  if [[ "$1" == "c" || "$1" == "create" ]]; then
    local name="${2:-}"
    local base="${3:-$(git rev-parse --abbrev-ref HEAD)}"
    local use_remote=0
    [[ -z "$name" ]] && echo "Usage: wt create <name> [base-branch] [--remote]" && return 1
    [[ "$3" == "--remote" || "$4" == "--remote" ]] && use_remote=1
  elif [[ "$1" == "install" ]]; then
    local new_path="${2:-}"
    [[ -z "$new_path" ]] && echo "Usage: wt install <path>" && return 1

    # Expand to absolute path
    new_path="${new_path:A}"
    mkdir -p "$new_path" || { echo "Failed to create directory: $new_path"; return 1; }

    # Persist as an export in ~/.zshrc — update in place if already there,
    # otherwise append.
    local rc="$HOME/.zshrc"
    if [[ -f "$rc" ]] && grep -q "^export WT_WORKTREES_DIR=" "$rc"; then
      sed -i '' "s|^export WT_WORKTREES_DIR=.*|export WT_WORKTREES_DIR=\"$new_path\"|" "$rc"
    else
      echo "export WT_WORKTREES_DIR=\"$new_path\"" >> "$rc"
    fi
    export WT_WORKTREES_DIR="$new_path"

    echo "Worktrees directory set to: $new_path"
    echo "Saved as: export WT_WORKTREES_DIR in $rc"
    return 0
  fi

  if [[ "$1" == "push" ]]; then
    local branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
    local remote_branch="${2:-$branch}"
    git push -u origin "$branch:$remote_branch" --force-with-lease
    return $?
  fi

  if [[ "$WT_WORKTREES_DIR" == "__NOT_CONFIGURED__" ]]; then
    echo "wt is not configured yet. Run: wt install <path>"
    return 1
  fi

  local main_worktree="$(git worktree list --porcelain | awk '/^worktree / { print $2; exit }')"
  local repo_name="$(basename "$main_worktree")"
  local worktrees_dir="$WT_WORKTREES_DIR/$repo_name"

  if [[ "$1" == "list" ]]; then
    git worktree list
    return 0
  fi

  if [[ "$1" == "switch" ]]; then
    local name="${2:-}"
    [[ -z "$name" ]] && echo "Usage: wt switch <name>" && return 1
    local target="$worktrees_dir/$name"
    if [[ ! -d "$target" ]]; then
      echo "wt switch: no worktree found at $target"
      return 1
    fi
    cd "$target"
    return 0
  fi

  if [[ "$1" == "clean" ]]; then
    local force=0
    local name=""

    # Parse args: --force and optional name can appear in any order
    for arg in "${@:2}"; do
      if [[ "$arg" == "--force" ]]; then
        force=1
      else
        name="$arg"
      fi
    done

    local main_repo="$(git worktree list --porcelain | awk '/^worktree / { if (NR==1) print $2 }')"

    if [[ -n "$name" ]]; then
      local worktree_path="$worktrees_dir/$name"
      if [[ ! -d "$worktree_path" ]]; then
        echo "wt clean: no worktree found at $worktree_path"
        return 1
      fi
      local branch="$name"
    else
      local worktree_path="$(pwd)"
      local branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
      if [[ "$worktree_path" == "$main_repo" ]]; then
        echo "wt clean: you're in the main worktree, not a linked one. Aborting."
        return 1
      fi
    fi

    if [[ $force -eq 0 ]]; then
      local uncommitted="$(git -C "$worktree_path" status --porcelain)"
      if [[ -n "$uncommitted" ]]; then
        echo "Uncommitted changes in $worktree_path:"
        git -C "$worktree_path" status --short
        echo "\nRun 'wt clean $name --force' to delete anyway."
        return 1
      fi
    fi

    [[ "$(pwd)" == "$worktree_path" ]] && cd "$main_repo"
    git worktree remove "$worktree_path" --force
    git branch -D "$branch"
    echo "Cleaned up worktree '$branch'."
    return 0
  fi

  if [[ "$1" != "create" && "$1" != "c" ]]; then
    local name="$1"
    local base="${2:-$(git rev-parse --abbrev-ref HEAD)}"
  fi

  local root="$main_worktree"
  if git rev-parse --verify "refs/heads/$name" &>/dev/null; then
    git worktree add "$worktrees_dir/$name" "$name" || return 1
  elif [[ $use_remote -eq 1 ]] && git fetch origin "$name" &>/dev/null && git rev-parse --verify "refs/remotes/origin/$name" &>/dev/null; then
    git worktree add "$worktrees_dir/$name" --track -b "$name" "origin/$name" || return 1
  else
    git worktree add "$worktrees_dir/$name" -b "$name" "$base" || return 1
  fi
  cd "$worktrees_dir/$name" || return 1
  # Bring each WT_LINK_IGNORED glob over from the main worktree. Files get
  # hard-linked so they behave like real files to tools that don't follow
  # symlinks; directories are symlinked (macOS can't hard-link directories).
  # Globs are evaluated against the main worktree.
  local pattern match rel
  for pattern in ${=WT_LINK_IGNORED}; do
    for match in $root/${~pattern}(N); do
      rel="${match#$root/}"
      mkdir -p "$(dirname "./$rel")"
      if [[ -d "$match" ]]; then
        ln -sfn "$match" "./$rel"
      else
        ln -f "$match" "./$rel"
      fi
    done
  done
}
