#!/usr/bin/env zsh
#
# Link the same ignored/shared files into an already-created git worktree.
#
# Codex creates managed worktrees itself, so it cannot use `wt create` directly
# without taking over branch/worktree lifecycle. This helper keeps only the
# useful post-create part: bring local config over from the main worktree using
# the same WT_LINK_IGNORED environment variable as `wt`.
#
# Files are hard-linked where possible and symlinked when the hard link is
# refused. link(2) needs the caller to be able to write through the source's
# directory, so a sandboxed caller (Codex workspace-write, an agent seatbelt)
# or a TCC-restricted one gets EPERM from `ln` while symlink(2) — which only
# writes inside the worktree — still works. Both share the file with the main
# worktree, so the fallback keeps the behaviour this script exists for.

set -uo pipefail

: "${WT_LINK_IGNORED:=CLAUDE.md CLAUDE.local.md .claude .env* .zed AGENTS.md .agents local .codex/config.toml}"
: "${WT_LINK_IGNORED_RECURSIVE:=0}"

warn() {
  echo "wt-link-ignored: warning: $*" >&2
}

current_worktree="$(git rev-parse --show-toplevel)"
main_worktree="$(git worktree list --porcelain | awk '/^worktree / { print $2; exit }')"

if [[ -z "$main_worktree" ]]; then
  warn "could not detect main worktree; skipping link setup"
  exit 0
fi

if [[ "$current_worktree" == "$main_worktree" ]]; then
  echo "wt-link-ignored: current directory is the main worktree; nothing to link"
  exit 0
fi

cd "$current_worktree"

typeset -A linked_paths
typeset -i failures=0
# Not an error: a caller that cannot hard-link still gets the file, just as a
# symlink. Report the count so a degraded run is visible without being fatal.
typeset -i symlink_fallbacks=0
symlink_note() {
  echo "wt-link-ignored: linked as symlink (hard link refused): $1" >&2
}

# Match the useful `wt create` behavior for Codex-managed worktrees: bring over
# the shared ignored/local paths after Codex has created the worktree. Unlike
# `wt create`, default to top-level matches only; a recursive `**/.env*` scan is
# fine in smaller repos but can hang setup for monorepos. Set
# WT_LINK_IGNORED_RECURSIVE=1 if a repo genuinely needs nested ignored files.
for pattern in ${=WT_LINK_IGNORED}; do
  matches=($main_worktree/${~pattern}(ND))

  if [[ "$WT_LINK_IGNORED_RECURSIVE" == "1" ]]; then
    matches+=($main_worktree/**/${~pattern}(ND^e:'[[ $REPLY == */.git/* || $REPLY == */node_modules/* ]]':))
  fi

  for match in $matches; do
    relative_path="${match#$main_worktree/}"
    target_path="./$relative_path"

    if [[ -n "${linked_paths[$relative_path]:-}" ]]; then
      continue
    fi
    linked_paths[$relative_path]=1

    # Never touch paths that are actually tracked in git. `git worktree add`
    # already checks these out correctly from the index; symlinking over a
    # tracked path (e.g. a committed .claude/ dir) makes git see every file
    # under it as deleted in this worktree's diff, since the tracked path is
    # now a symlink pointing elsewhere. This is only for ignored/untracked
    # shared config, so skip tracked matches entirely.
    if git -C "$main_worktree" ls-files --error-unmatch -- "$relative_path" >/dev/null 2>&1; then
      continue
    fi
    if [[ -d "$match" ]] && [[ -n "$(git -C "$main_worktree" ls-files -- "$relative_path" | head -n1)" ]]; then
      continue
    fi

    if [[ -e "$target_path" || -L "$target_path" ]]; then
      # Codex setup is best-effort glue. It runs before the agent starts, so a
      # stale tracked AGENTS.md, copied .codex directory, or partial local/
      # directory should never abort the whole worktree. If the path is not
      # already the intended link/hardlink, remove it and recreate it from the
      # main worktree. This can dirty the disposable worktree, but that is less
      # surprising than losing repo-local instructions, skills, or local notes.
      if [[ "$target_path" -ef "$match" ]] ||
         [[ "$(readlink "$target_path" 2>/dev/null || true)" == "$match" ]]; then
        continue
      fi

      if ! rm -rf "$target_path"; then
        warn "could not replace existing path: $relative_path"
        failures+=1
        continue
      fi
    fi

    if ! mkdir -p "$(dirname "$target_path")"; then
      warn "could not create parent directory for: $relative_path"
      failures+=1
      continue
    fi

    if [[ -d "$match" || "$relative_path" == "AGENTS.md" ]]; then
      ln -s "$match" "$target_path" || {
        warn "could not symlink: $relative_path"
        failures+=1
      }
    elif ln "$match" "$target_path" 2>/dev/null; then
      : # hard link: same inode, so the worktree sees a real file
    elif ln -s "$match" "$target_path"; then
      symlink_fallbacks+=1
      symlink_note "$relative_path"
    else
      warn "could not link: $relative_path"
      failures+=1
    fi
  done
done

if (( symlink_fallbacks > 0 )); then
  echo "wt-link-ignored: ${symlink_fallbacks} path(s) symlinked instead of hard-linked (caller cannot link into the main worktree; not fatal)" >&2
fi

# Keep this invocation contract in sync with `_wt_run_post_create_hook` in
# worktree/wt. Codex owns worktree creation, so this script is its equivalent
# post-create boundary. The hook may background long-running work and return
# immediately; failures are warnings because the worktree itself is usable.
if [[ -n "${WT_POST_CREATE_HOOK:-}" ]]; then
  if [[ ! -x "$WT_POST_CREATE_HOOK" ]]; then
    warn "WT_POST_CREATE_HOOK is not executable: $WT_POST_CREATE_HOOK"
  else
    WT_MAIN_WORKTREE="$main_worktree" \
      WT_NEW_WORKTREE="$current_worktree" \
      WT_REPO_NAME="${main_worktree:t}" \
      WT_BRANCH="$(git -C "$current_worktree" branch --show-current 2>/dev/null)" \
      "$WT_POST_CREATE_HOOK" "$current_worktree" ||
        warn "post-create hook failed: $WT_POST_CREATE_HOOK"
  fi
fi

# Succeed only when every intended path actually landed. A hard-link refusal is
# recovered as a symlink and stays non-fatal, but a path that could not be
# linked at all must not be reported to Codex/T3 as a clean setup.
if (( failures > 0 )); then
  warn "${failures} path(s) could not be linked"
  exit 1
fi

exit 0
